<!-- Module purpose: Defines the accessible visual structure for Main Window; behaviour remains in its code-behind module. -->
<Window x:Class="DBNotifier.Desktop.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:DBNotifier.Desktop.Wpf"
        Title="{DynamicResource App.Title}"
        Width="1180"
        Height="760"
        MinWidth="820"
        MinHeight="620"
        Background="{DynamicResource ComponentAppBackgroundBrush}"
        Foreground="{DynamicResource ColourTextPrimaryBrush}"
        FontFamily="{DynamicResource TypographyFontfamilySans}"
        WindowStartupLocation="CenterScreen"
        SizeChanged="WindowSizeChanged"
        KeyboardNavigation.TabNavigation="Cycle">
  <Window.Resources>
    <Style TargetType="Button">
      <Setter Property="MinHeight" Value="{DynamicResource ControlHeightCompact}" />
      <Setter Property="Padding" Value="16,8" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="{DynamicResource ComponentButtonSecondaryBorderBrush}" />
      <Setter Property="Background" Value="{DynamicResource ComponentButtonSecondaryBackgroundBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource ComponentButtonSecondaryForegroundBrush}" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="ButtonBorder"
                    Padding="{TemplateBinding Padding}"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="6">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource ColourSelectionBackgroundBrush}" />
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{DynamicResource ComponentFocusRingBrush}" />
                <Setter TargetName="ButtonBorder" Property="BorderThickness" Value="2" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.58" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="ComboBox">
      <Setter Property="MinHeight" Value="{DynamicResource ControlHeightCompact}" />
      <Setter Property="MaxDropDownHeight" Value="320" />
      <Setter Property="Padding" Value="10,5" />
      <Setter Property="Background" Value="{DynamicResource ComponentInputBackgroundBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource ComponentInputForegroundBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ComponentInputBorderBrush}" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ComboBox">
            <Grid>
              <ToggleButton x:Name="DropDownToggle"
                            Focusable="False"
                            ClickMode="Press"
                            Foreground="{Binding Foreground, RelativeSource={RelativeSource TemplatedParent}}"
                            IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                <ToggleButton.Template>
                  <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="InputBorder"
                            Background="{Binding Background, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                            BorderBrush="{Binding BorderBrush, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                            BorderThickness="1"
                            CornerRadius="6">
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="32" />
                        </Grid.ColumnDefinitions>
                        <ContentPresenter Margin="10,5"
                                          VerticalAlignment="Center"
                                          Content="{Binding SelectionBoxItem, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                          ContentTemplate="{Binding SelectionBoxItemTemplate, RelativeSource={RelativeSource AncestorType=ComboBox}}" />
                        <Path Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" Data="M 0 0 L 4 4 L 8 0" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ComboBox}}" StrokeThickness="1.5" />
                      </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                      <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="InputBorder" Property="BorderBrush" Value="{DynamicResource ColourBorderStrongBrush}" />
                      </Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </ToggleButton.Template>
              </ToggleButton>
              <Popup x:Name="PART_Popup"
                     Placement="Bottom"
                     IsOpen="{TemplateBinding IsDropDownOpen}"
                     AllowsTransparency="True"
                     Focusable="False"
                     PopupAnimation="Fade">
                <Border MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                        Margin="0,2,0,0"
                        Padding="2"
                        Background="{DynamicResource ComponentInputBackgroundBrush}"
                        BorderBrush="{DynamicResource ComponentInputBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="6">
                  <ScrollViewer MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                CanContentScroll="True"
                                VerticalScrollBarVisibility="Auto"
                                HorizontalScrollBarVisibility="Disabled">
                    <StackPanel IsItemsHost="True" />
                  </ScrollViewer>
                </Border>
              </Popup>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsKeyboardFocusWithin" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource ComponentFocusRingBrush}" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.58" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="ComboBoxItem">
      <Setter Property="MinHeight" Value="32" />
      <Setter Property="Padding" Value="10,6" />
      <Setter Property="Foreground" Value="{DynamicResource ComponentInputForegroundBrush}" />
      <Setter Property="Background" Value="{DynamicResource ComponentInputBackgroundBrush}" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ComboBoxItem">
            <Border x:Name="ItemBorder" Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}" CornerRadius="4">
              <ContentPresenter />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsHighlighted" Value="True">
                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource ColourSelectionBackgroundBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource ColourSelectionForegroundBrush}" />
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource ColourSelectionBackgroundBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource ColourSelectionForegroundBrush}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <!-- Read-only tables remain one task-order stop while virtualised cells retain grid semantics outside the Tab sequence. -->
    <Style TargetType="DataGrid">
      <Setter Property="Background" Value="{DynamicResource ComponentCardBackgroundBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource ColourTextPrimaryBrush}" />
      <Setter Property="RowBackground" Value="{DynamicResource ColourSurfaceDefaultBrush}" />
      <Setter Property="AlternatingRowBackground" Value="{DynamicResource ColourSurfaceSubtleBrush}" />
      <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource ColourBorderDefaultBrush}" />
      <Setter Property="VerticalGridLinesBrush" Value="{DynamicResource ColourBorderDefaultBrush}" />
      <Setter Property="KeyboardNavigation.IsTabStop" Value="True" />
      <Setter Property="KeyboardNavigation.TabNavigation" Value="None" />
    </Style>
    <Style TargetType="DataGridColumnHeader">
      <Setter Property="Background" Value="{DynamicResource ColourSurfaceSubtleBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource ColourTextPrimaryBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ColourBorderDefaultBrush}" />
      <Setter Property="Padding" Value="12,0" />
      <Setter Property="MinHeight" Value="40" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="ContentTemplate">
        <Setter.Value>
          <DataTemplate>
            <TextBlock Text="{Binding}" TextWrapping="Wrap" VerticalAlignment="Center" />
          </DataTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="DataGridRow">
      <Setter Property="Foreground" Value="{DynamicResource ColourTextPrimaryBrush}" />
    </Style>
    <Style TargetType="DataGridCell">
      <Setter Property="BorderBrush" Value="{DynamicResource ColourBorderDefaultBrush}" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="KeyboardNavigation.IsTabStop" Value="False" />
      <Setter Property="Padding" Value="12,0" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="VerticalContentAlignment" Value="Stretch" />
      <Style.Triggers>
        <Trigger Property="IsSelected" Value="True">
          <Setter Property="Background" Value="{DynamicResource ColourSelectionBackgroundBrush}" />
          <Setter Property="Foreground" Value="{DynamicResource ColourSelectionForegroundBrush}" />
        </Trigger>
        <Trigger Property="IsKeyboardFocusWithin" Value="True">
          <Setter Property="BorderBrush" Value="{DynamicResource ComponentFocusRingBrush}" />
          <Setter Property="BorderThickness" Value="1" />
        </Trigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="SummaryCard" TargetType="Border">
      <Setter Property="Background" Value="{DynamicResource ComponentCardBackgroundBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ComponentCardBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Padding" Value="18" />
      <Setter Property="Margin" Value="0,0,12,0" />
    </Style>
    <Style x:Key="TopbarIconButton" TargetType="Button">
      <Setter Property="Width" Value="{DynamicResource ControlHeightCompact}" />
      <Setter Property="Height" Value="{DynamicResource ControlHeightCompact}" />
      <Setter Property="MinHeight" Value="{DynamicResource ControlHeightCompact}" />
      <Setter Property="Padding" Value="7" />
      <Setter Property="Margin" Value="2,0" />
      <Setter Property="Foreground" Value="{DynamicResource ComponentShellChromeMutedBrush}" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="PreferenceBorder"
                    Padding="{TemplateBinding Padding}"
                    BorderThickness="1"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    CornerRadius="6"
                    Background="{TemplateBinding Background}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="PreferenceBorder" Property="Background" Value="{DynamicResource ComponentShellChromeSurfaceBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource ComponentShellChromeForegroundBrush}" />
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="PreferenceBorder" Property="BorderBrush" Value="{DynamicResource ComponentFocusRingBrush}" />
                <Setter TargetName="PreferenceBorder" Property="BorderThickness" Value="2" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="SidebarNavigationButton" TargetType="Button">
      <Setter Property="MinHeight" Value="44" />
      <Setter Property="Margin" Value="10,2" />
      <Setter Property="Padding" Value="12,9" />
      <Setter Property="Background" Value="{DynamicResource ColourSurfaceSubtleBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource ColourTextPrimaryBrush}" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="3,0,0,0" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="NavigationBorder"
                    Padding="{TemplateBinding Padding}"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="6">
              <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="NavigationBorder" Property="Background" Value="{DynamicResource ColourSurfaceDefaultBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource ColourTextPrimaryBrush}" />
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="NavigationBorder" Property="BorderBrush" Value="{DynamicResource ComponentFocusRingBrush}" />
                <Setter TargetName="NavigationBorder" Property="BorderThickness" Value="3,2,2,2" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <!-- Navigation geometry is code-native and independent of installed symbol fonts. -->
    <Style x:Key="SidebarNavigationIcon" TargetType="Path">
      <Setter Property="Width" Value="18" />
      <Setter Property="Height" Value="18" />
      <Setter Property="Margin" Value="0,0,8,0" />
      <Setter Property="Stroke" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
      <Setter Property="StrokeThickness" Value="1.5" />
      <Setter Property="StrokeLineJoin" Value="Round" />
      <Setter Property="Stretch" Value="Uniform" />
    </Style>
    <!-- Compact route templates retain every read-only field when a desktop table cannot fit the native window. -->
    <Style x:Key="CompactFieldLabel" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource ColourTextSecondaryBrush}" />
      <Setter Property="FontSize" Value="10" />
      <Setter Property="Margin" Value="0,0,10,0" />
      <Setter Property="VerticalAlignment" Value="Top" />
    </Style>
    <Style x:Key="CompactFieldValue" TargetType="TextBlock">
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="VerticalAlignment" Value="Top" />
    </Style>
    <!-- WPF DataGridCell does not template-bind Padding into every generated content presenter. The Space3-equivalent
         12-DIP content gutter therefore lives on desktop cell content so adjacent fields remain visually distinct. -->
    <Style x:Key="DesktopDataGridContent" TargetType="{x:Type FrameworkElement}">
      <Setter Property="Margin" Value="12,0" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="WrappingDataGridText" TargetType="TextBlock" BasedOn="{StaticResource DesktopDataGridContent}">
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <!-- Compact records own their internal spacing, so desktop table padding must not be applied twice. -->
    <Style x:Key="CompactDataGridCell" TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}">
      <Setter Property="Padding" Value="0" />
    </Style>
    <ItemsPanelTemplate x:Key="ProviderCatalogueDesktopPanel">
      <UniformGrid Columns="2" />
    </ItemsPanelTemplate>
    <ItemsPanelTemplate x:Key="ProviderCatalogueCompactPanel">
      <UniformGrid Columns="1" />
    </ItemsPanelTemplate>
    <!-- Overview instance rows follow the Web reading order without squeezing latency and trend into one narrow desktop row. -->
    <DataTemplate x:Key="OverviewInventoryDesktopRowTemplate">
      <Border MinHeight="52" Padding="18,0" BorderBrush="{DynamicResource ColourBorderDefaultBrush}" BorderThickness="0,1,0,0">
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="30" /><ColumnDefinition Width="1.25*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="54" /><ColumnDefinition Width="96" /></Grid.ColumnDefinitions>
          <local:ProviderIdentityView Identity="{Binding ProviderIdentity}" IconSize="24" ShowText="False" VerticalAlignment="Center" />
          <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0"><TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding InstanceId}" AutomationProperties.HelpText="{Binding InstanceId}" /><TextBlock Text="{Binding ProviderType}" Foreground="{DynamicResource ColourTextSecondaryBrush}" FontSize="10" Margin="0,2,0,0" /></StackPanel>
          <local:StatusPill Grid.Column="2" Text="{Binding StatusLabel}" Tone="{Binding StatusTone}" Icon="{Binding StatusIcon}" VerticalAlignment="Center" Margin="4,0,8,0" />
          <TextBlock Grid.Column="3" Text="{Binding LatencyLabel}" Foreground="{DynamicResource ColourTextSecondaryBrush}" VerticalAlignment="Center" HorizontalAlignment="Right" />
          <Viewbox Grid.Column="4" Height="28" Margin="10,0,0,0" Stretch="Fill" VerticalAlignment="Center" IsHitTestVisible="False">
            <Polyline Points="{Binding SparklinePoints}" StrokeThickness="1.7" Fill="Transparent">
              <Polyline.Style><Style TargetType="Polyline"><Setter Property="Stroke" Value="{DynamicResource ComponentStatusNeutralForegroundBrush}" /><Style.Triggers><DataTrigger Binding="{Binding SparklineTone}" Value="Healthy"><Setter Property="Stroke" Value="{DynamicResource ComponentStatusHealthyForegroundBrush}" /></DataTrigger><DataTrigger Binding="{Binding SparklineTone}" Value="Degraded"><Setter Property="Stroke" Value="{DynamicResource ComponentStatusDegradedForegroundBrush}" /></DataTrigger><DataTrigger Binding="{Binding SparklineTone}" Value="Critical"><Setter Property="Stroke" Value="{DynamicResource ComponentStatusCriticalForegroundBrush}" /></DataTrigger></Style.Triggers></Style></Polyline.Style>
            </Polyline>
          </Viewbox>
        </Grid>
      </Border>
    </DataTemplate>
    <DataTemplate x:Key="OverviewInventoryCompactRowTemplate">
      <Border MinHeight="76" Padding="14,10" BorderBrush="{DynamicResource ColourBorderDefaultBrush}" BorderThickness="0,1,0,0">
        <Grid>
          <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
          <Grid.ColumnDefinitions><ColumnDefinition Width="30" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
          <local:ProviderIdentityView Grid.RowSpan="2" Identity="{Binding ProviderIdentity}" IconSize="24" ShowText="False" VerticalAlignment="Top" Margin="0,2,0,0" />
          <StackPanel Grid.Column="1" Margin="8,0,10,0"><TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" TextWrapping="Wrap" ToolTip="{Binding InstanceId}" AutomationProperties.HelpText="{Binding InstanceId}" /><TextBlock Text="{Binding ProviderType}" Foreground="{DynamicResource ColourTextSecondaryBrush}" FontSize="10" Margin="0,2,0,0" /></StackPanel>
          <local:StatusPill Grid.Column="2" Text="{Binding StatusLabel}" Tone="{Binding StatusTone}" Icon="{Binding StatusIcon}" VerticalAlignment="Top" />
          <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding LatencyLabel}" Foreground="{DynamicResource ColourTextSecondaryBrush}" Margin="8,8,10,0" VerticalAlignment="Center" />
          <Viewbox Grid.Row="1" Grid.Column="2" Width="96" Height="22" Margin="0,8,0,0" Stretch="Fill" HorizontalAlignment="Right" VerticalAlignment="Center" IsHitTestVisible="False">
            <Polyline Points="{Binding SparklinePoints}" StrokeThickness="1.7" Fill="Transparent">
              <Polyline.Style><Style TargetType="Polyline"><Setter Property="Stroke" Value="{DynamicResource ComponentStatusNeutralForegroundBrush}" /><Style.Triggers><DataTrigger Binding="{Binding SparklineTone}" Value="Healthy"><Setter Property="Stroke" Value="{DynamicResource ComponentStatusHealthyForegroundBrush}" /></DataTrigger><DataTrigger Binding="{Binding SparklineTone}" Value="Degraded"><Setter Property="Stroke" Value="{DynamicResource ComponentStatusDegradedForegroundBrush}" /></DataTrigger><DataTrigger Binding="{Binding SparklineTone}" Value="Critical"><Setter Property="Stroke" Value="{DynamicResource ComponentStatusCriticalForegroundBrush}" /></DataTrigger></Style.Triggers></Style></Polyline.Style>
            </Polyline>
          </Viewbox>
        </Grid>
      </Border>
    </DataTemplate>
    <DataTemplate x:Key="InventoryCompactRowTemplate">
      <Border Padding="14,12" BorderBrush="{DynamicResource ColourBorderDefaultBrush}" BorderThickness="0,1,0,0">
        <StackPanel>
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" TextWrapping="Wrap" AutomationProperties.HelpText="{Binding InstanceId}" />
            <local:StatusPill Grid.Column="1" Text="{Binding StatusLabel}" Tone="{Binding StatusTone}" Icon="{Binding StatusIcon}" Margin="12,0,0,0" VerticalAlignment="Top" />
          </Grid>
          <local:ProviderIdentityView Identity="{Binding ProviderIdentity}" IconSize="20" FontSize="11" Margin="0,8,0,10" />
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <TextBlock Text="{DynamicResource Common.Instance}" Style="{StaticResource CompactFieldLabel}" />
            <TextBlock Grid.Column="1" Text="{Binding InstanceId}" Style="{StaticResource CompactFieldValue}" AutomationProperties.Name="{Binding InstanceId}" />
            <TextBlock Grid.Row="1" Text="{DynamicResource Common.Support}" Style="{StaticResource CompactFieldLabel}" Margin="0,6,10,0" />
            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SupportLabel}" Style="{StaticResource CompactFieldValue}" Margin="0,6,0,0" />
            <TextBlock Grid.Row="2" Text="{DynamicResource Common.Environment}" Style="{StaticResource CompactFieldLabel}" Margin="0,6,10,0" />
            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Environment}" Style="{StaticResource CompactFieldValue}" Margin="0,6,0,0" />
            <TextBlock Grid.Row="3" Text="{DynamicResource Common.ObservedAtUtc}" Style="{StaticResource CompactFieldLabel}" Margin="0,6,10,0" />
            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding ObservedAtLabel}" Style="{StaticResource CompactFieldValue}" Margin="0,6,0,0" />
            <TextBlock Grid.Row="4" Text="{DynamicResource Common.Latency}" Style="{StaticResource CompactFieldLabel}" Margin="0,6,10,0" />
            <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding LatencyLabel}" Style="{StaticResource CompactFieldValue}" Margin="0,6,0,0" />
          </Grid>
        </StackPanel>
      </Border>
    </DataTemplate>
    <DataTemplate x:Key="TimelineCompactRowTemplate">
      <Border Padding="14,12" BorderBrush="{DynamicResource ColourBorderDefaultBrush}" BorderThickness="0,1,0,0">
        <StackPanel>
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <TextBlock Text="{Binding EventType}" FontWeight="SemiBold" TextWrapping="Wrap" />
            <local:StatusPill Grid.Column="1" Text="{Binding SeverityLabel}" Tone="{Binding Tone}" Icon="{Binding Path=IconKind}" Margin="12,0,0,0" VerticalAlignment="Top" />
          </Grid>
          <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" Margin="0,8,0,10" />
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <TextBlock Text="{DynamicResource Common.TimeUtc}" Style="{StaticResource CompactFieldLabel}" />
            <TextBlock Grid.Column="1" Text="{Binding OccurredAtLabel}" Style="{StaticResource CompactFieldValue}" />
            <TextBlock Grid.Row="1" Text="{DynamicResource Common.Instance}" Style="{StaticResource CompactFieldLabel}" Margin="0,6,10,0" />
            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding InstanceName}" Style="{StaticResource CompactFieldValue}" Margin="0,6,0,0" />
            <TextBlock Grid.Row="2" Text="{DynamicResource Common.Provider}" Style="{StaticResource CompactFieldLabel}" Margin="0,6,10,0" />
            <local:ProviderIdentityView Grid.Row="2" Grid.Column="1" Identity="{Binding ProviderIdentity}" IconSize="18" FontSize="11" Margin="0,6,0,0" />
          </Grid>
        </StackPanel>
      </Border>
    </DataTemplate>
    <DataTemplate x:Key="AlertCompactRowTemplate">
      <Border Padding="14,12" BorderBrush="{DynamicResource ColourBorderDefaultBrush}" BorderThickness="0,1,0,0">
        <StackPanel>
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <TextBlock Text="{Binding RuleName}" FontWeight="SemiBold" TextWrapping="Wrap" />
            <local:StatusPill Grid.Column="1" Text="{Binding SeverityLabel}" Tone="{Binding Tone}" Icon="{Binding Path=IconKind}" Margin="12,0,0,0" VerticalAlignment="Top" />
          </Grid>
          <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" Margin="0,8,0,10" />
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <TextBlock Text="{DynamicResource Common.State}" Style="{StaticResource CompactFieldLabel}" />
            <TextBlock Grid.Column="1" Text="{Binding StateLabel}" Style="{StaticResource CompactFieldValue}" />
            <TextBlock Grid.Row="1" Text="{DynamicResource Common.Instance}" Style="{StaticResource CompactFieldLabel}" Margin="0,6,10,0" />
            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding InstanceName}" Style="{StaticResource CompactFieldValue}" Margin="0,6,0,0" />
            <TextBlock Grid.Row="2" Text="{DynamicResource Common.Provider}" Style="{StaticResource CompactFieldLabel}" Margin="0,6,10,0" />
            <local:ProviderIdentityView Grid.Row="2" Grid.Column="1" Identity="{Binding ProviderIdentity}" IconSize="18" FontSize="11" Margin="0,6,0,0" />
            <TextBlock Grid.Row="3" Text="{DynamicResource Common.Updated}" Style="{StaticResource CompactFieldLabel}" Margin="0,6,10,0" />
            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding UpdatedAtLabel}" Style="{StaticResource CompactFieldValue}" Margin="0,6,0,0" />
          </Grid>
        </StackPanel>
      </Border>
    </DataTemplate>
    <DataTemplate x:Key="ConfigurationCompactRowTemplate">
      <Border Padding="14,12" BorderBrush="{DynamicResource ColourBorderDefaultBrush}" BorderThickness="0,1,0,0">
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
          <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
          <TextBlock Text="{DynamicResource Common.Field}" Style="{StaticResource CompactFieldLabel}" />
          <TextBlock Grid.Column="1" Text="{Binding Label}" FontWeight="SemiBold" Style="{StaticResource CompactFieldValue}" />
          <TextBlock Grid.Row="1" Text="{DynamicResource Common.SafeValue}" Style="{StaticResource CompactFieldLabel}" Margin="0,6,10,0" />
          <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SafeValue}" Style="{StaticResource CompactFieldValue}" Margin="0,6,0,0" />
          <TextBlock Grid.Row="2" Text="{DynamicResource Common.Description}" Style="{StaticResource CompactFieldLabel}" Margin="0,6,10,0" />
          <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Description}" Style="{StaticResource CompactFieldValue}" Foreground="{DynamicResource ColourTextSecondaryBrush}" Margin="0,6,0,0" />
        </Grid>
      </Border>
    </DataTemplate>
    <DataTemplate x:Key="CapabilityCompactRowTemplate">
      <Border Padding="14,12" BorderBrush="{DynamicResource ColourBorderDefaultBrush}" BorderThickness="0,1,0,0">
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
          <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
          <TextBlock Text="{DynamicResource Common.Action}" Style="{StaticResource CompactFieldLabel}" />
          <TextBlock Grid.Column="1" Text="{Binding DisplayName}" FontWeight="SemiBold" Style="{StaticResource CompactFieldValue}" />
          <TextBlock Grid.Row="1" Text="{DynamicResource Common.State}" Style="{StaticResource CompactFieldLabel}" Margin="0,6,10,0" />
          <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding StateLabel}" Style="{StaticResource CompactFieldValue}" Margin="0,6,0,0" />
          <TextBlock Grid.Row="2" Text="{DynamicResource Common.Capability}" Style="{StaticResource CompactFieldLabel}" Margin="0,6,10,0" />
          <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding CapabilityId}" Style="{StaticResource CompactFieldValue}" Margin="0,6,0,0" />
          <TextBlock Grid.Row="3" Text="{DynamicResource Common.Reason}" Style="{StaticResource CompactFieldLabel}" Margin="0,6,10,0" />
          <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding ReasonCode}" Style="{StaticResource CompactFieldValue}" Margin="0,6,0,0" />
        </Grid>
      </Border>
    </DataTemplate>
  </Window.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- The cohesive chrome keeps product identity and low-emphasis preferences stable in every theme. -->
    <Border x:Name="DesktopTopBar" Grid.Row="0" Background="{DynamicResource ComponentShellChromeBackgroundBrush}" BorderBrush="{DynamicResource ComponentShellChromeBorderBrush}" BorderThickness="0,0,0,1" Padding="28,12">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Image x:Name="BrandStatusImage" Width="40" Height="40" Stretch="None" SnapsToDevicePixels="True" AutomationProperties.Name="DB Notifier" />
          <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal"><TextBlock Text="DB" Foreground="{DynamicResource ComponentBrandWordmarkAccentBrush}" FontWeight="Bold" FontSize="16" /><TextBlock Text="Notifier" Foreground="{DynamicResource ComponentShellChromeForegroundBrush}" FontWeight="Bold" FontSize="16" /></StackPanel>
            <TextBlock Text="{DynamicResource Brand.Subtitle}" Foreground="{DynamicResource ComponentShellChromeMutedBrush}" FontSize="12" Margin="0,3,0,0" />
          </StackPanel>
        </StackPanel>
        <WrapPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
          <Button x:Name="LanguagePreferenceButton" Style="{StaticResource TopbarIconButton}" Click="LanguagePreferenceButtonClick" AutomationProperties.Name="{DynamicResource Language.Label}">
            <Viewbox Width="20" Height="20">
              <Canvas Width="24" Height="24">
                <Path Data="M 2,5 H 14 M 7,2 H 8 M 5,8 L 11,14 M 4,14 L 10,8 L 12,5 M 12,22 L 17,12 L 22,22 M 14,18 H 20" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
              </Canvas>
            </Viewbox>
          </Button>
          <Button x:Name="ThemePreferenceButton" Style="{StaticResource TopbarIconButton}" Click="ThemePreferenceButtonClick" AutomationProperties.Name="{DynamicResource Theme.Label}" Margin="4,0,10,0">
            <Grid Width="20" Height="20">
              <Viewbox x:Name="LightThemeIcon" Width="20" Height="20">
                <Canvas Width="24" Height="24">
                  <Ellipse Canvas.Left="8.5" Canvas.Top="8.5" Width="7" Height="7" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.8" />
                  <Path Data="M 12,2.5 V 5.5 M 12,18.5 V 21.5 M 2.5,12 H 5.5 M 18.5,12 H 21.5 M 5.3,5.3 L 7.4,7.4 M 16.6,16.6 L 18.7,18.7 M 18.7,5.3 L 16.6,7.4 M 7.4,16.6 L 5.3,18.7" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                </Canvas>
              </Viewbox>
              <Viewbox x:Name="DarkThemeIcon" Width="20" Height="20" Visibility="Collapsed">
                <Canvas Width="24" Height="24">
                  <Path Data="M 20,15.2 A 8.3,8.3 0 0 1 8.8,4 A 8.5,8.5 0 1 0 20,15.2 Z" Fill="Transparent" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                </Canvas>
              </Viewbox>
            </Grid>
          </Button>
          <Button x:Name="NotificationButton" Style="{StaticResource TopbarIconButton}" Click="NotificationButtonClick" AutomationProperties.Name="{DynamicResource TopBar.NotificationsSimple}">
            <Path Width="20" Height="20" Data="M 5,16 H 19 L 17.5,14 V 9.5 A 5.5,5.5 0 0 0 6.5,9.5 V 14 Z M 10,19 H 14" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.8" Fill="Transparent" Stretch="Uniform" />
          </Button>
          <Button x:Name="SettingsButton" Style="{StaticResource TopbarIconButton}" Click="SettingsButtonClick" AutomationProperties.Name="{DynamicResource TopBar.Settings}" Margin="4,0,10,0">
            <Viewbox Width="20" Height="20"><Canvas Width="24" Height="24"><Ellipse Canvas.Left="8.5" Canvas.Top="8.5" Width="7" Height="7" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.8" /><Path Data="M 12,2 V 5 M 12,19 V 22 M 2,12 H 5 M 19,12 H 22 M 5,5 L 7,7 M 17,17 L 19,19 M 19,5 L 17,7 M 7,17 L 5,19" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.8" /></Canvas></Viewbox>
          </Button>
          <Border Background="{DynamicResource ComponentShellChromeSurfaceBrush}" CornerRadius="14" Padding="12,6" VerticalAlignment="Center">
            <TextBlock Text="{DynamicResource Demo.Badge}" Foreground="{DynamicResource ComponentShellChromeMutedBrush}" FontSize="11" FontWeight="SemiBold" />
          </Border>
        </WrapPanel>
      </Grid>
    </Border>

    <!-- Desktop navigation mirrors the Web information architecture while retaining native WPF behaviour. -->
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="230" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <!-- The neutral navigation rail matches the Web information hierarchy while reserving chrome for product identity. -->
      <Border x:Name="DesktopNavigationRail" Grid.Column="0" Background="{DynamicResource ColourSurfaceSubtleBrush}" BorderBrush="{DynamicResource ColourBorderDefaultBrush}" BorderThickness="0,0,1,0">
        <DockPanel LastChildFill="True">
          <Border x:Name="SidebarStateCard" DockPanel.Dock="Bottom" Margin="14" Padding="12" Background="{DynamicResource ComponentCardBackgroundBrush}" BorderBrush="{DynamicResource ComponentCardBorderBrush}" BorderThickness="1" CornerRadius="7">
            <StackPanel><TextBlock Text="STATE-05" Foreground="{DynamicResource ColourActionPrimaryBackgroundBrush}" FontWeight="SemiBold" /><TextBlock Text="{DynamicResource Common.ReadOnly}" Foreground="{DynamicResource ColourTextSecondaryBrush}" FontSize="11" Margin="0,4,0,0" /></StackPanel>
          </Border>
          <StackPanel Margin="0,18,0,0" AutomationProperties.Name="{DynamicResource Navigation.Label}">
            <TextBlock Text="{DynamicResource Navigation.Label}" Foreground="{DynamicResource ColourTextSecondaryBrush}" FontSize="10" Margin="22,0,0,8" />
            <Button x:Name="OverviewNavigationButton" Style="{StaticResource SidebarNavigationButton}" Tag="Overview" Click="NavigationButtonClick" AutomationProperties.Name="{DynamicResource Navigation.Overview}"><StackPanel Orientation="Horizontal"><Path Style="{StaticResource SidebarNavigationIcon}" Data="M3,10 L10,3 L17,10 M5,9 V18 H15 V9 M8,18 V13 H12 V18" /><TextBlock Text="{DynamicResource Navigation.Overview}" VerticalAlignment="Center" /></StackPanel></Button>
            <Button x:Name="InventoryNavigationButton" Style="{StaticResource SidebarNavigationButton}" Tag="Inventory" Click="NavigationButtonClick" AutomationProperties.Name="{DynamicResource Navigation.Inventory}"><StackPanel Orientation="Horizontal"><Path Style="{StaticResource SidebarNavigationIcon}" Data="M3,3 H17 V17 H3 Z M6,7 H14 M6,10 H14 M6,13 H14" /><TextBlock Text="{DynamicResource Navigation.Inventory}" VerticalAlignment="Center" /></StackPanel></Button>
            <Button x:Name="AlertsNavigationButton" Style="{StaticResource SidebarNavigationButton}" Tag="Alerts" Click="NavigationButtonClick" AutomationProperties.Name="{DynamicResource Navigation.Alerts}"><StackPanel Orientation="Horizontal"><Path Style="{StaticResource SidebarNavigationIcon}" Data="M10,3 L18,17 H2 Z M10,8 V12 M10,15 H10.01" /><TextBlock Text="{DynamicResource Navigation.Alerts}" VerticalAlignment="Center" /></StackPanel></Button>
            <Button x:Name="PerformanceNavigationButton" Style="{StaticResource SidebarNavigationButton}" Tag="Performance" Click="NavigationButtonClick" AutomationProperties.Name="{DynamicResource Navigation.Performance}"><StackPanel Orientation="Horizontal"><Path Style="{StaticResource SidebarNavigationIcon}" Data="M3,17 V3 M3,17 H18 M6,14 L9,10 L12,12 L17,6" /><TextBlock Text="{DynamicResource Navigation.Performance}" VerticalAlignment="Center" /></StackPanel></Button>
            <Button x:Name="HistoryNavigationButton" Style="{StaticResource SidebarNavigationButton}" Tag="History" Click="NavigationButtonClick" AutomationProperties.Name="{DynamicResource Navigation.History}"><StackPanel Orientation="Horizontal"><Path Style="{StaticResource SidebarNavigationIcon}" Data="M10,3 A7,7 0 1 1 3,10 M3,5 V10 H8 M10,6 V10 L13,12" /><TextBlock Text="{DynamicResource Navigation.History}" VerticalAlignment="Center" /></StackPanel></Button>
            <Button x:Name="ConfigurationNavigationButton" Style="{StaticResource SidebarNavigationButton}" Tag="Configuration" Click="NavigationButtonClick" AutomationProperties.Name="{DynamicResource Navigation.Configuration}"><StackPanel Orientation="Horizontal"><Path Style="{StaticResource SidebarNavigationIcon}" Data="M3,6 H12 M15,6 H18 M3,14 H7 M10,14 H18 M13.5,3 V9 M8.5,11 V17" /><TextBlock Text="{DynamicResource Navigation.Configuration}" VerticalAlignment="Center" /></StackPanel></Button>
            <Button x:Name="ProvidersNavigationButton" Style="{StaticResource SidebarNavigationButton}" Tag="Providers" Click="NavigationButtonClick" AutomationProperties.Name="{DynamicResource Navigation.Providers}"><StackPanel Orientation="Horizontal"><Path Style="{StaticResource SidebarNavigationIcon}" Data="M3,4 H9 V10 H3 Z M11,4 H17 V10 H11 Z M3,12 H9 V18 H3 Z M11,12 H17 V18 H11 Z" /><TextBlock Text="{DynamicResource Navigation.Providers}" VerticalAlignment="Center" /></StackPanel></Button>
            <Button x:Name="SettingsNavigationButton" Style="{StaticResource SidebarNavigationButton}" Tag="Settings" Click="NavigationButtonClick" AutomationProperties.Name="{DynamicResource Navigation.Settings}"><StackPanel Orientation="Horizontal"><Path Style="{StaticResource SidebarNavigationIcon}" Data="M10,3 V5 M10,15 V17 M3,10 H5 M15,10 H17 M5,5 L6.5,6.5 M13.5,13.5 L15,15 M15,5 L13.5,6.5 M6.5,13.5 L5,15 M10,7 A3,3 0 1 1 10,13 A3,3 0 1 1 10,7" /><TextBlock Text="{DynamicResource Navigation.Settings}" VerticalAlignment="Center" /></StackPanel></Button>
          </StackPanel>
        </DockPanel>
      </Border>

    <ScrollViewer x:Name="DesktopContentScrollViewer" Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="{DynamicResource App.Title}">
      <Grid x:Name="DesktopContentRoot" Margin="32,28">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid x:Name="DesktopPageHeader" Grid.Row="0">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
          <StackPanel x:Name="DesktopPageHeadingText">
            <TextBlock x:Name="ViewEyebrowText" Foreground="{DynamicResource ColourActionPrimaryBackgroundBrush}" FontSize="11" FontWeight="SemiBold" TextWrapping="Wrap" />
            <TextBlock x:Name="ViewTitleText" FontSize="28" FontWeight="SemiBold" Margin="0,4,0,0" TextWrapping="Wrap" />
            <TextBlock x:Name="ViewDescriptionText" Foreground="{DynamicResource ColourTextSecondaryBrush}" Margin="0,5,0,0" TextWrapping="Wrap" />
            <TextBlock x:Name="UpdatedAtText" Foreground="{DynamicResource ColourTextSecondaryBrush}" Margin="0,5,0,0" TextWrapping="Wrap" />
          </StackPanel>
          <WrapPanel x:Name="DesktopScenarioPanel" Grid.Column="1" Margin="24,0,0,0" HorizontalAlignment="Right" VerticalAlignment="Center">
            <TextBlock Text="{DynamicResource Scenario.Label}" VerticalAlignment="Center" Margin="0,0,10,0" />
            <ComboBox x:Name="ScenarioSelector"
                      Width="180"
                      SelectedIndex="0"
                      SelectionChanged="ScenarioSelectionChanged"
                      AutomationProperties.Name="{DynamicResource Scenario.Label}">
              <ComboBoxItem Content="{DynamicResource Scenario.Ready}" Tag="Ready" />
              <ComboBoxItem Content="{DynamicResource Scenario.Loading}" Tag="Loading" />
              <ComboBoxItem Content="{DynamicResource Scenario.Empty}" Tag="Empty" />
              <ComboBoxItem Content="{DynamicResource Scenario.Offline}" Tag="Offline" />
              <ComboBoxItem Content="{DynamicResource Scenario.Error}" Tag="Error" />
              <ComboBoxItem Content="{DynamicResource Scenario.Denied}" Tag="Denied" />
              <ComboBoxItem Content="{DynamicResource Scenario.Maintenance}" Tag="Maintenance" />
            </ComboBox>
          </WrapPanel>
        </Grid>

        <!-- The overview mirrors the Web information hierarchy while remaining a deterministic, read-only WPF surface. -->
        <Grid x:Name="OverviewSurface" Grid.Row="1" Margin="0,22,0,0">
          <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
          <UniformGrid x:Name="OverviewSummaryGrid" Columns="4">
            <local:KpiCard x:Name="OverviewTotalCard" Margin="8" Label="{DynamicResource Overview.TotalInstances}" Value="{Binding Text, ElementName=OverviewTotalCountText}" Detail="{Binding Text, ElementName=OverviewDisabledCountText}" Icon="Database" Tone="Neutral" />
            <local:KpiCard x:Name="OverviewHealthyCard" Margin="8" Label="{DynamicResource Inventory.Healthy}" Value="{Binding Text, ElementName=OverviewHealthyCountText}" Icon="Healthy" Tone="Healthy" />
            <local:KpiCard x:Name="OverviewWarningCard" Margin="8" Label="{DynamicResource Overview.Warning}" Value="{Binding Text, ElementName=OverviewDegradedCountText}" Icon="Degraded" Tone="Degraded" />
            <local:KpiCard x:Name="OverviewCriticalCard" Margin="8" Label="{DynamicResource Overview.Critical}" Value="{Binding Text, ElementName=OverviewAttentionCountText}" Icon="Critical" Tone="Critical" />
          </UniformGrid>
          <!-- Hidden binding anchors retain the existing atomic count update contract. -->
          <StackPanel Visibility="Collapsed"><TextBlock x:Name="OverviewTotalCountText" /><TextBlock x:Name="OverviewDisabledCountText" /><TextBlock x:Name="OverviewHealthyCountText" /><TextBlock x:Name="OverviewDegradedCountText" /><TextBlock x:Name="OverviewAttentionCountText" /></StackPanel>

          <Grid x:Name="OverviewOperationalGrid" Grid.Row="1" Margin="0,18,0,0">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <Grid.ColumnDefinitions><ColumnDefinition Width="2*" /><ColumnDefinition Width="16" /><ColumnDefinition Width="1*" /></Grid.ColumnDefinitions>
            <Border x:Name="OverviewFleetPanel" Background="{DynamicResource ComponentCardBackgroundBrush}" BorderBrush="{DynamicResource ComponentCardBorderBrush}" BorderThickness="1" CornerRadius="10">
              <Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <Grid Margin="18,14"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{DynamicResource Overview.FleetStatus}" FontSize="16" FontWeight="SemiBold" /><TextBlock Text="{DynamicResource Overview.FleetDescription}" Foreground="{DynamicResource ColourTextSecondaryBrush}" FontSize="12" Margin="0,4,0,0" /></StackPanel><TextBlock Grid.Column="1" Text="{DynamicResource Overview.ResponseTime}" Foreground="{DynamicResource ColourTextSecondaryBrush}" FontSize="10" VerticalAlignment="Bottom" /></Grid>
                <ItemsControl x:Name="OverviewInventoryList"
                              Grid.Row="1"
                              ItemTemplate="{StaticResource OverviewInventoryDesktopRowTemplate}"
                              AutomationProperties.Name="{DynamicResource Overview.FleetStatus}" />
              </Grid>
            </Border>
            <Border x:Name="OverviewAlertsPanel" Grid.Column="2" Background="{DynamicResource ComponentCardBackgroundBrush}" BorderBrush="{DynamicResource ComponentCardBorderBrush}" BorderThickness="1" CornerRadius="10">
              <Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <StackPanel Margin="18,14"><TextBlock Text="{DynamicResource Overview.RecentAlerts}" FontSize="16" FontWeight="SemiBold" /><TextBlock Text="{DynamicResource Overview.AlertDescription}" Foreground="{DynamicResource ColourTextSecondaryBrush}" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap" /></StackPanel>
                <ItemsControl x:Name="OverviewAlertList" Grid.Row="1" AutomationProperties.Name="{DynamicResource Overview.RecentAlerts}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border MinHeight="58" Padding="12,0" BorderBrush="{DynamicResource ColourBorderDefaultBrush}" BorderThickness="0,1,0,0">
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="34" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                          <Border Width="28" Height="28" CornerRadius="5" BorderThickness="1" BorderBrush="{DynamicResource ColourBorderStrongBrush}" VerticalAlignment="Center"><local:SemanticIcon Kind="{Binding IconKind}" Width="15" Height="15" Foreground="{DynamicResource ColourTextPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                          <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="6,0"><TextBlock Text="{Binding InstanceName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" /><TextBlock Text="{Binding RuleName}" Foreground="{DynamicResource ColourTextSecondaryBrush}" FontSize="10" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" /></StackPanel>
                          <TextBlock Grid.Column="2" Text="{Binding UpdatedAtLabel}" Foreground="{DynamicResource ColourTextSecondaryBrush}" FontSize="9" VerticalAlignment="Center" />
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Button Grid.Row="2" Content="{DynamicResource Overview.ViewAlerts}" Click="OverviewViewAlertsClick" Margin="12,10,12,12" />
              </Grid>
            </Border>
          </Grid>

          <Grid x:Name="OverviewInsightsGrid" Grid.Row="2" Margin="0,18,0,0">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <Grid.ColumnDefinitions><ColumnDefinition Width="2*" /><ColumnDefinition Width="16" /><ColumnDefinition Width="1*" /></Grid.ColumnDefinitions>
            <Border x:Name="OverviewPerformancePanel" Background="{DynamicResource ComponentCardBackgroundBrush}" BorderBrush="{DynamicResource ComponentCardBorderBrush}" BorderThickness="1" CornerRadius="10">
              <Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="176" /></Grid.RowDefinitions>
                <Grid Margin="18,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{DynamicResource Overview.SampleTrend}" FontSize="16" FontWeight="SemiBold" /><TextBlock Text="{DynamicResource Overview.DemonstrationChart}" Foreground="{DynamicResource ColourTextSecondaryBrush}" FontSize="11" Margin="0,3,0,0" /></StackPanel><Border Grid.Column="1" Background="{DynamicResource ColourSurfaceSubtleBrush}" CornerRadius="12" Padding="10,5" VerticalAlignment="Center"><TextBlock Text="{DynamicResource Demo.Badge}" Foreground="{DynamicResource ComponentStatusNeutralForegroundBrush}" FontSize="9" FontWeight="SemiBold" /></Border></Grid>
                <local:PerformanceChart x:Name="OverviewPerformanceChart" Grid.Row="1" Margin="14,0,14,10" />
              </Grid>
            </Border>
            <local:AuditableCardBorder x:Name="OverviewProvidersPanel" AutomationProperties.AutomationId="OverviewProviderCard" Grid.Column="2" Background="{DynamicResource ComponentCardBackgroundBrush}" BorderBrush="{DynamicResource ComponentCardBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="18,14">
              <Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions><StackPanel><TextBlock Text="{DynamicResource Overview.ProviderFixture}" FontSize="16" FontWeight="SemiBold" /><TextBlock Text="{DynamicResource Overview.ProviderDescription}" Foreground="{DynamicResource ColourTextSecondaryBrush}" FontSize="11" Margin="0,4,0,8" TextWrapping="Wrap" /></StackPanel><local:ProviderDistributionChart x:Name="OverviewProviderDistribution" Grid.Row="1" /></Grid>
            </local:AuditableCardBorder>
          </Grid>
        </Grid>

        <Grid x:Name="ReadySurface" Grid.Row="1" Margin="0,22,0,0" Visibility="Collapsed">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <UniformGrid x:Name="InventorySummaryGrid" Columns="6">
            <local:KpiCard x:Name="InventoryTotalCard" Margin="8" Label="{DynamicResource Inventory.Total}" Value="{Binding Text, ElementName=TotalCountText}" Icon="Database" Tone="Neutral" />
            <local:KpiCard x:Name="InventoryHealthyCard" Margin="8" Label="{DynamicResource Inventory.Healthy}" Value="{Binding Text, ElementName=HealthyCountText}" Icon="Healthy" Tone="Healthy" />
            <local:KpiCard x:Name="InventoryDegradedCard" Margin="8" Label="{DynamicResource Inventory.Degraded}" Value="{Binding Text, ElementName=DegradedCountText}" Icon="Degraded" Tone="Degraded" />
            <local:KpiCard x:Name="InventoryAttentionCard" Margin="8" Label="{DynamicResource Inventory.Attention}" Value="{Binding Text, ElementName=AttentionCountText}" Icon="Critical" Tone="Critical" />
            <local:KpiCard x:Name="InventoryStaleCard" Margin="8" Label="{DynamicResource Inventory.Stale}" Value="{Binding Text, ElementName=StaleCountText}" Icon="Stale" Tone="Neutral" />
            <local:KpiCard x:Name="InventoryDisabledCard" Margin="8" Label="{DynamicResource Inventory.Disabled}" Value="{Binding Text, ElementName=DisabledCountText}" Icon="Database" Tone="Neutral" />
          </UniformGrid>
          <StackPanel Visibility="Collapsed"><TextBlock x:Name="TotalCountText" /><TextBlock x:Name="HealthyCountText" /><TextBlock x:Name="DegradedCountText" /><TextBlock x:Name="AttentionCountText" /><TextBlock x:Name="StaleCountText" /><TextBlock x:Name="DisabledCountText" /></StackPanel>

          <Border Grid.Row="1" Background="{DynamicResource ComponentCardBackgroundBrush}" BorderBrush="{DynamicResource ComponentCardBorderBrush}" BorderThickness="1" CornerRadius="12" Margin="0,20,0,0">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
              </Grid.RowDefinitions>
              <Grid Grid.Row="0" Margin="18,14">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{DynamicResource Inventory.Title}" FontSize="16" FontWeight="SemiBold" />
                <TextBlock Grid.Column="1" Text="{DynamicResource Common.ReadOnly}" Foreground="{DynamicResource ColourTextSecondaryBrush}" />
              </Grid>
              <DataGrid x:Name="InventoryGrid"
                        Grid.Row="1"
                        AutoGenerateColumns="False"
                        IsReadOnly="True"
                        CanUserAddRows="False"
                        CanUserDeleteRows="False"
                        CanUserReorderColumns="False"
                        HeadersVisibility="Column"
                        GridLinesVisibility="Horizontal"
                        BorderThickness="0"
                        MinRowHeight="48"
                        AlternatingRowBackground="{DynamicResource ColourSurfaceSubtleBrush}"
                        SelectionMode="Single"
                        AutomationProperties.Name="{DynamicResource View.Inventory.Title}">
                <DataGrid.Columns>
                  <DataGridTemplateColumn Header="{DynamicResource Common.Instance}" SortMemberPath="DisplayName" Width="1.15*"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Style="{StaticResource DesktopDataGridContent}" Text="{Binding DisplayName}" ToolTip="{Binding InstanceId}" AutomationProperties.HelpText="{Binding InstanceId}" TextWrapping="Wrap" /></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                  <DataGridTemplateColumn Header="{DynamicResource Common.Provider}" SortMemberPath="ProviderType" Width="1.1*"><DataGridTemplateColumn.CellTemplate><DataTemplate><local:ProviderIdentityView Style="{StaticResource DesktopDataGridContent}" Identity="{Binding ProviderIdentity}" IconSize="20" FontSize="11" /></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                  <DataGridTextColumn Header="{DynamicResource Common.Support}" Binding="{Binding SupportLabel}" Width="1.3*" ElementStyle="{StaticResource WrappingDataGridText}" />
                  <DataGridTextColumn Header="{DynamicResource Common.Environment}" Binding="{Binding Environment}" Width="*" ElementStyle="{StaticResource WrappingDataGridText}" />
                  <DataGridTemplateColumn Header="{DynamicResource Common.Status}" SortMemberPath="StatusLabel" Width="1.65*"><DataGridTemplateColumn.CellTemplate><DataTemplate><local:StatusPill Style="{StaticResource DesktopDataGridContent}" Text="{Binding StatusLabel}" Tone="{Binding StatusTone}" Icon="{Binding StatusIcon}" /></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                  <DataGridTextColumn Header="{DynamicResource Common.ObservedAt}" Binding="{Binding ObservedAtLabel}" Width="1.35*" ElementStyle="{StaticResource WrappingDataGridText}" />
                  <DataGridTextColumn Header="{DynamicResource Common.Latency}" Binding="{Binding LatencyLabel}" Width="0.65*" ElementStyle="{StaticResource WrappingDataGridText}" />
                  <DataGridTemplateColumn Header="{DynamicResource View.Inventory.Title}" Width="*" Visibility="Collapsed" CellStyle="{StaticResource CompactDataGridCell}">
                    <DataGridTemplateColumn.CellTemplate><StaticResource ResourceKey="InventoryCompactRowTemplate" /></DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>
                </DataGrid.Columns>
              </DataGrid>
            </Grid>
          </Border>
        </Grid>

        <Grid x:Name="HistoryAlertSurface" Grid.Row="1" Margin="0,22,0,0" Visibility="Collapsed">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <Border x:Name="HistoryPanel" Background="{DynamicResource ComponentCardBackgroundBrush}" BorderBrush="{DynamicResource ComponentCardBorderBrush}" BorderThickness="1" CornerRadius="10">
            <Grid>
              <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
              <Grid Margin="18,14"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{DynamicResource History.Title}" FontSize="16" FontWeight="SemiBold" /><TextBlock x:Name="HistorySummaryText" Foreground="{DynamicResource ColourTextSecondaryBrush}" FontSize="11" Margin="0,3,0,0" /></StackPanel><TextBlock Grid.Column="1" Text="{DynamicResource Common.ReadOnly}" Foreground="{DynamicResource ColourTextSecondaryBrush}" /></Grid>
              <DataGrid x:Name="HistoryGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal" BorderThickness="0" MinRowHeight="46" AlternatingRowBackground="{DynamicResource ColourSurfaceSubtleBrush}" ScrollViewer.HorizontalScrollBarVisibility="Auto" AutomationProperties.Name="{DynamicResource History.Title}">
                <DataGrid.Columns>
                  <DataGridTextColumn Header="{DynamicResource Common.TimeUtc}" Binding="{Binding OccurredAtLabel}" Width="1.25*" ElementStyle="{StaticResource WrappingDataGridText}" />
                  <DataGridTemplateColumn Header="{DynamicResource Common.Severity}" SortMemberPath="SeverityLabel" Width="1.15*"><DataGridTemplateColumn.CellTemplate><DataTemplate><local:StatusPill Style="{StaticResource DesktopDataGridContent}" Text="{Binding SeverityLabel}" Tone="{Binding Tone}" Icon="{Binding IconKind}" /></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                  <DataGridTextColumn Header="{DynamicResource Common.Event}" Binding="{Binding EventType}" Width="1.35*" ElementStyle="{StaticResource WrappingDataGridText}" />
                  <DataGridTextColumn Header="{DynamicResource Common.Instance}" Binding="{Binding InstanceName}" Width="1.1*" ElementStyle="{StaticResource WrappingDataGridText}" />
                  <DataGridTemplateColumn Header="{DynamicResource Common.Provider}" SortMemberPath="ProviderType" Width="0.95*"><DataGridTemplateColumn.CellTemplate><DataTemplate><local:ProviderIdentityView Style="{StaticResource DesktopDataGridContent}" Identity="{Binding ProviderIdentity}" IconSize="18" FontSize="11" /></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                  <DataGridTextColumn Header="{DynamicResource Common.Summary}" Binding="{Binding Summary}" Width="1.8*" ElementStyle="{StaticResource WrappingDataGridText}" />
                  <DataGridTemplateColumn Header="{DynamicResource History.Title}" Width="*" Visibility="Collapsed" CellStyle="{StaticResource CompactDataGridCell}">
                    <DataGridTemplateColumn.CellTemplate><StaticResource ResourceKey="TimelineCompactRowTemplate" /></DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>
                </DataGrid.Columns>
              </DataGrid>
            </Grid>
          </Border>
          <Grid x:Name="AlertsPanel" Grid.Row="1" Margin="0,18,0,0">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <UniformGrid x:Name="AlertSummaryGrid" Columns="3">
              <local:KpiCard x:Name="AlertCriticalCard" Margin="8" Label="{DynamicResource Alerts.CriticalOpen}" Value="{Binding Text, ElementName=AlertCriticalCountText}" Icon="Critical" Tone="Critical" />
              <local:KpiCard x:Name="AlertActiveCard" Margin="8" Label="{DynamicResource Alerts.Active}" Value="{Binding Text, ElementName=AlertActiveCountText}" Icon="Degraded" Tone="Degraded" />
              <local:KpiCard x:Name="AlertTotalCard" Margin="8" Label="{DynamicResource Alerts.TotalVisible}" Value="{Binding Text, ElementName=AlertTotalCountText}" Icon="Healthy" Tone="Neutral" />
            </UniformGrid>
            <StackPanel Visibility="Collapsed"><TextBlock x:Name="AlertCriticalCountText" /><TextBlock x:Name="AlertActiveCountText" /><TextBlock x:Name="AlertTotalCountText" /></StackPanel>
            <Border Grid.Row="1" Background="{DynamicResource ComponentCardBackgroundBrush}" BorderBrush="{DynamicResource ComponentCardBorderBrush}" BorderThickness="1" CornerRadius="10" Margin="0,18,0,0">
              <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <Grid Margin="18,14"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{DynamicResource Alerts.Title}" FontSize="16" FontWeight="SemiBold" /><TextBlock Text="{DynamicResource Alerts.Description}" Foreground="{DynamicResource ColourTextSecondaryBrush}" FontSize="11" Margin="0,3,0,0" /></StackPanel><TextBlock Grid.Column="1" x:Name="AlertSummaryText" Foreground="{DynamicResource ColourTextSecondaryBrush}" /></Grid>
                <DataGrid x:Name="AlertsGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal" BorderThickness="0" MinRowHeight="52" AlternatingRowBackground="{DynamicResource ColourSurfaceSubtleBrush}" ScrollViewer.HorizontalScrollBarVisibility="Auto" AutomationProperties.Name="{DynamicResource Alerts.Title}">
                  <DataGrid.Columns>
                    <DataGridTemplateColumn Header="{DynamicResource Common.Severity}" SortMemberPath="SeverityLabel" Width="1.35*"><DataGridTemplateColumn.CellTemplate><DataTemplate><local:StatusPill Style="{StaticResource DesktopDataGridContent}" Text="{Binding SeverityLabel}" Tone="{Binding Tone}" Icon="{Binding IconKind}" /></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                    <DataGridTextColumn Header="{DynamicResource Common.State}" Binding="{Binding StateLabel}" Width="1.2*" ElementStyle="{StaticResource WrappingDataGridText}" />
                    <DataGridTextColumn Header="{DynamicResource Common.Rule}" Binding="{Binding RuleName}" Width="1.25*" ElementStyle="{StaticResource WrappingDataGridText}" />
                    <DataGridTextColumn Header="{DynamicResource Common.Instance}" Binding="{Binding InstanceName}" Width="1.15*" ElementStyle="{StaticResource WrappingDataGridText}" />
                    <DataGridTemplateColumn Header="{DynamicResource Common.Provider}" SortMemberPath="ProviderType" Width="1.15*"><DataGridTemplateColumn.CellTemplate><DataTemplate><local:ProviderIdentityView Style="{StaticResource DesktopDataGridContent}" Identity="{Binding ProviderIdentity}" IconSize="18" FontSize="11" /></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                    <DataGridTextColumn Header="{DynamicResource Common.Summary}" Binding="{Binding Summary}" Width="1.7*" ElementStyle="{StaticResource WrappingDataGridText}" />
                    <DataGridTextColumn Header="{DynamicResource Common.Updated}" Binding="{Binding UpdatedAtLabel}" Width="1.4*" ElementStyle="{StaticResource WrappingDataGridText}" />
                    <DataGridTemplateColumn Header="{DynamicResource Alerts.Title}" Width="*" Visibility="Collapsed" CellStyle="{StaticResource CompactDataGridCell}">
                      <DataGridTemplateColumn.CellTemplate><StaticResource ResourceKey="AlertCompactRowTemplate" /></DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                  </DataGrid.Columns>
                </DataGrid>
              </Grid>
            </Border>
          </Grid>
        </Grid>

        <!-- Standalone performance and provider destinations preserve the Web route contract without loading external telemetry. -->
        <Border x:Name="PerformanceSurface" Grid.Row="1" Visibility="Collapsed" Background="{DynamicResource ComponentCardBackgroundBrush}" BorderBrush="{DynamicResource ComponentCardBorderBrush}" BorderThickness="1" CornerRadius="10" Margin="0,22,0,0">
          <Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="290" /></Grid.RowDefinitions>
            <Grid Margin="22,16"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{DynamicResource Overview.SampleTrend}" FontSize="18" FontWeight="SemiBold" /><TextBlock Text="{DynamicResource Overview.DemonstrationChart}" Foreground="{DynamicResource ColourTextSecondaryBrush}" Margin="0,5,0,0" /></StackPanel><Border x:Name="PerformanceDemonstrationBadge" Grid.Column="1" Background="{DynamicResource ColourSurfaceSubtleBrush}" CornerRadius="12" Padding="11,6" VerticalAlignment="Center"><TextBlock Text="{DynamicResource Demo.Badge}" Foreground="{DynamicResource ComponentStatusNeutralForegroundBrush}" FontSize="10" FontWeight="SemiBold" /></Border></Grid>
            <local:PerformanceChart x:Name="PerformanceRouteChart" Grid.Row="1" Margin="18,0,18,14" />
          </Grid>
        </Border>

        <Grid x:Name="ProvidersSurface" Grid.Row="1" Visibility="Collapsed" Margin="0,22,0,0">
          <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
          <local:AuditableCardBorder AutomationProperties.AutomationId="ProvidersRouteDistributionCard" Background="{DynamicResource ComponentCardBackgroundBrush}" BorderBrush="{DynamicResource ComponentCardBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="22">
            <Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions><StackPanel><TextBlock Text="{DynamicResource Overview.ProviderFixture}" FontSize="18" FontWeight="SemiBold" /><TextBlock Text="{DynamicResource Overview.ProviderDescription}" Foreground="{DynamicResource ColourTextSecondaryBrush}" Margin="0,5,0,14" TextWrapping="Wrap" /></StackPanel><local:ProviderDistributionChart x:Name="ProvidersDistribution" Grid.Row="1" /></Grid>
          </local:AuditableCardBorder>
          <Border Grid.Row="1" Background="{DynamicResource ComponentCardBackgroundBrush}" BorderBrush="{DynamicResource ComponentCardBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="18" Margin="0,18,0,0">
            <ItemsControl x:Name="ProviderCatalogueList"
                          ItemsPanel="{StaticResource ProviderCatalogueDesktopPanel}"
                          AutomationProperties.Name="{DynamicResource View.Providers.Title}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Background="{DynamicResource ColourSurfaceSubtleBrush}" BorderBrush="{DynamicResource ColourBorderDefaultBrush}" BorderThickness="1" CornerRadius="8" Margin="5" Padding="18">
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                      <local:ProviderIdentityView Identity="{Binding ProviderIdentity}" IconSize="32" ShowText="False" VerticalAlignment="Center" />
                      <StackPanel Grid.Column="1" Margin="12,0" VerticalAlignment="Center"><TextBlock Text="{Binding ProviderIdentity.ProviderType}" FontSize="13" FontWeight="SemiBold" /><TextBlock Text="{Binding SupportLabel}" Foreground="{DynamicResource ColourTextSecondaryBrush}" FontSize="10" Margin="0,3,0,0" TextWrapping="Wrap" /></StackPanel>
                      <Border Grid.Column="2" Background="{DynamicResource ComponentStatusNeutralBackgroundBrush}" CornerRadius="12" Padding="10,5" VerticalAlignment="Center"><TextBlock Text="{DynamicResource Common.ReadOnly}" Foreground="{DynamicResource ComponentStatusNeutralForegroundBrush}" FontSize="9" FontWeight="SemiBold" /></Border>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </Border>
        </Grid>

        <Grid x:Name="ConfigurationSurface" Grid.Row="1" Margin="0,22,0,0" Visibility="Collapsed">
          <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
          <Border Background="{DynamicResource ComponentCardBackgroundBrush}" BorderBrush="{DynamicResource ComponentCardBorderBrush}" BorderThickness="1" CornerRadius="10">
            <Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
              <Grid x:Name="ConfigurationSnapshotHeader" Margin="18,14">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel><TextBlock Text="{DynamicResource Wpf.ConfigurationTitle}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" /><TextBlock x:Name="ConfigurationInstanceText" Foreground="{DynamicResource ColourTextSecondaryBrush}" Margin="0,4,0,0" TextWrapping="Wrap" /><local:ProviderIdentityView x:Name="ConfigurationProviderIdentity" IconSize="18" FontSize="11" Margin="0,4,0,0" /></StackPanel>
                <TextBlock x:Name="ConfigurationNotPersistedText" Grid.Column="1" Text="{DynamicResource Common.NotPersisted}" Foreground="{DynamicResource ColourTextSecondaryBrush}" TextWrapping="Wrap" />
              </Grid>
              <DataGrid x:Name="ConfigurationGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column" BorderThickness="0" MinRowHeight="46" ScrollViewer.HorizontalScrollBarVisibility="Auto" AutomationProperties.Name="{DynamicResource Wpf.ConfigurationTitle}">
                <DataGrid.Columns>
                  <DataGridTextColumn Header="{DynamicResource Common.Field}" Binding="{Binding Label}" Width="1.3*" ElementStyle="{StaticResource WrappingDataGridText}" />
                  <DataGridTextColumn Header="{DynamicResource Common.SafeValue}" Binding="{Binding SafeValue}" Width="*" ElementStyle="{StaticResource WrappingDataGridText}" />
                  <DataGridTextColumn Header="{DynamicResource Common.Description}" Binding="{Binding Description}" Width="2*" ElementStyle="{StaticResource WrappingDataGridText}" />
                  <DataGridTemplateColumn Header="{DynamicResource Wpf.ConfigurationTitle}" Width="*" Visibility="Collapsed" CellStyle="{StaticResource CompactDataGridCell}">
                    <DataGridTemplateColumn.CellTemplate><StaticResource ResourceKey="ConfigurationCompactRowTemplate" /></DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>
                </DataGrid.Columns>
              </DataGrid>
            </Grid>
          </Border>
          <Border Grid.Row="1" Background="{DynamicResource ComponentCardBackgroundBrush}" BorderBrush="{DynamicResource ComponentCardBorderBrush}" BorderThickness="1" CornerRadius="10" Margin="0,18,0,0">
            <Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
              <Grid x:Name="ConfigurationCapabilityHeader" Margin="18,14">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel><TextBlock Text="{DynamicResource Configuration.AdminTitle}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" /><TextBlock Text="{DynamicResource Wpf.NoAction}" Foreground="{DynamicResource ColourTextSecondaryBrush}" Margin="0,4,0,0" TextWrapping="Wrap" /></StackPanel>
                <ComboBox x:Name="PermissionSelector" Grid.Column="1" Width="170" SelectedIndex="0" AutomationProperties.Name="{DynamicResource Configuration.PermissionScenario}"><ComboBoxItem Content="{DynamicResource Configuration.Authorized}" Tag="Authorized" /><ComboBoxItem Content="{DynamicResource Configuration.Denied}" Tag="Denied" /></ComboBox>
              </Grid>
              <DataGrid x:Name="CapabilityGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column" BorderThickness="0" MinRowHeight="46" SelectionMode="Single" ScrollViewer.HorizontalScrollBarVisibility="Auto" AutomationProperties.Name="{DynamicResource Configuration.AdminTitle}">
                <DataGrid.Columns>
                  <DataGridTextColumn Header="{DynamicResource Common.Action}" Binding="{Binding DisplayName}" Width="*" ElementStyle="{StaticResource WrappingDataGridText}" />
                  <DataGridTextColumn Header="{DynamicResource Common.Capability}" Binding="{Binding CapabilityId}" Width="1.2*" ElementStyle="{StaticResource WrappingDataGridText}" />
                  <DataGridTextColumn Header="{DynamicResource Common.State}" Binding="{Binding StateLabel}" Width="*" ElementStyle="{StaticResource WrappingDataGridText}" />
                  <DataGridTextColumn Header="{DynamicResource Common.Reason}" Binding="{Binding ReasonCode}" Width="1.5*" ElementStyle="{StaticResource WrappingDataGridText}" />
                  <DataGridTemplateColumn Header="{DynamicResource Configuration.AdminTitle}" Width="*" Visibility="Collapsed" CellStyle="{StaticResource CompactDataGridCell}">
                    <DataGridTemplateColumn.CellTemplate><StaticResource ResourceKey="CapabilityCompactRowTemplate" /></DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>
                </DataGrid.Columns>
              </DataGrid>
              <WrapPanel x:Name="CapabilityActionsPanel" Grid.Row="2" HorizontalAlignment="Right" Margin="18,12"><Button x:Name="ReviewCapabilityButton" Content="{DynamicResource Wpf.ReviewSelected}" Click="ReviewCapabilityClick" Margin="0,0,10,0" /><Button x:Name="PreviewConfirmationButton" Content="{DynamicResource Configuration.ViewConfirmation}" Click="PreviewConfirmationClick" /></WrapPanel>
            </Grid>
          </Border>
        </Grid>

        <Grid x:Name="SettingsSurface" Grid.Row="1" Margin="0,22,0,0" Visibility="Collapsed">
          <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
          <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="18" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
          <Border x:Name="SettingsPreferencePanel" Background="{DynamicResource ComponentCardBackgroundBrush}" BorderBrush="{DynamicResource ComponentCardBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="22"><StackPanel><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Border Width="38" Height="38" Background="{DynamicResource ComponentStatusInformationBackgroundBrush}" CornerRadius="19"><local:SemanticIcon Kind="Settings" Width="19" Height="19" Foreground="{DynamicResource ComponentStatusInformationForegroundBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border><TextBlock x:Name="SettingsPreferenceTitleText" Grid.Column="1" Text="{DynamicResource Settings.PreferenceTitle}" FontSize="18" FontWeight="SemiBold" Margin="12,0,0,0" VerticalAlignment="Center" /></Grid><TextBlock Text="{DynamicResource View.Settings.Description}" Foreground="{DynamicResource ColourTextSecondaryBrush}" Margin="0,12,0,18" TextWrapping="Wrap" /><TextBlock Text="{DynamicResource Language.Label}" FontWeight="SemiBold" /><TextBlock x:Name="SettingsLanguageText" Foreground="{DynamicResource ColourTextSecondaryBrush}" Margin="0,4,0,14" /><TextBlock Text="{DynamicResource Theme.Label}" FontWeight="SemiBold" /><TextBlock x:Name="SettingsThemeText" Foreground="{DynamicResource ColourTextSecondaryBrush}" Margin="0,4,0,0" /></StackPanel></Border>
          <Border x:Name="SettingsNotificationsPanel" Grid.Column="2" Background="{DynamicResource ComponentCardBackgroundBrush}" BorderBrush="{DynamicResource ComponentCardBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="22"><StackPanel><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Border Width="38" Height="38" Background="{DynamicResource ComponentStatusNeutralBackgroundBrush}" CornerRadius="19"><local:SemanticIcon Kind="Notification" Width="19" Height="19" Foreground="{DynamicResource ComponentStatusNeutralForegroundBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border><TextBlock x:Name="SettingsNotificationTitleText" Grid.Column="1" Text="{DynamicResource Settings.NotificationTitle}" FontSize="18" FontWeight="SemiBold" Margin="12,0,0,0" VerticalAlignment="Center" /></Grid><TextBlock Text="{DynamicResource Settings.NotificationUnavailable}" Foreground="{DynamicResource ColourTextSecondaryBrush}" Margin="0,12,0,18" TextWrapping="Wrap" /><Border HorizontalAlignment="Left" Background="{DynamicResource ColourSurfaceSubtleBrush}" CornerRadius="12" Padding="12,6"><TextBlock Text="STATE-06" Foreground="{DynamicResource ComponentStatusNeutralForegroundBrush}" FontWeight="SemiBold" /></Border></StackPanel></Border>
        </Grid>

        <Border x:Name="StateSurface"
                Grid.Row="1"
                Visibility="Collapsed"
                Background="{DynamicResource ComponentCardBackgroundBrush}"
                BorderBrush="{DynamicResource ComponentCardBorderBrush}"
                BorderThickness="1"
                CornerRadius="10"
                Padding="44"
                Margin="0,22,0,0"
                MinHeight="300"
                AutomationProperties.Name="{DynamicResource Operational.Loading.Title}">
          <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="560">
            <ProgressBar x:Name="LoadingIndicator" IsIndeterminate="True" Width="220" Height="6" Margin="0,0,0,24" />
            <TextBlock x:Name="StateSymbolText" TextAlignment="Center" FontSize="32" FontWeight="SemiBold" Foreground="{DynamicResource ColourActionPrimaryBackgroundBrush}" />
            <TextBlock x:Name="StateTitleText" TextAlignment="Center" FontSize="22" FontWeight="SemiBold" Margin="0,12,0,0" />
            <TextBlock x:Name="StateMessageText" TextAlignment="Center" TextWrapping="Wrap" Foreground="{DynamicResource ColourTextSecondaryBrush}" FontSize="14" LineHeight="22" Margin="0,10,0,0" AutomationProperties.LiveSetting="Polite" />
            <Button x:Name="RetryButton" Content="{DynamicResource Operational.Retry}" Margin="0,22,0,0" Click="RetryButtonClick" AutomationProperties.HelpText="{DynamicResource Operational.Retry}" />
          </StackPanel>
        </Border>
      </Grid>
    </ScrollViewer>
    </Grid>

    <Border x:Name="DesktopFooterStatus" Grid.Row="2" Background="{DynamicResource ComponentCardBackgroundBrush}" BorderBrush="{DynamicResource ComponentCardBorderBrush}" BorderThickness="0,1,0,0" Padding="28,12">
      <TextBlock Foreground="{DynamicResource ColourTextSecondaryBrush}" FontSize="12" Text="{DynamicResource Footer.Disclaimer}" TextWrapping="Wrap" />
    </Border>
  </Grid>
</Window>
