<!-- Module purpose: Defines the accessible visual structure for Main Window; behaviour remains in its code-behind module. -->
<Window x:Class="DBNotifier.Desktop.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource App.Title}"
        Width="1180"
        Height="760"
        MinWidth="820"
        MinHeight="620"
        Icon="Assets/DBNotifier.ico"
        Background="{DynamicResource ComponentAppBackgroundBrush}"
        Foreground="{DynamicResource ColourTextPrimaryBrush}"
        FontFamily="{DynamicResource TypographyFontfamilySans}"
        WindowStartupLocation="CenterScreen"
        KeyboardNavigation.TabNavigation="Cycle">
  <Window.Resources>
    <Style TargetType="Button">
      <Setter Property="MinHeight" Value="{DynamicResource ControlHeightCompact}" />
      <Setter Property="Padding" Value="16,8" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="{DynamicResource ComponentButtonSecondaryBorderBrush}" />
      <Setter Property="Background" Value="{DynamicResource ComponentButtonSecondaryBackgroundBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource ComponentButtonSecondaryForegroundBrush}" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="ButtonBorder"
                    Padding="{TemplateBinding Padding}"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="6">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource ColourSelectionBackgroundBrush}" />
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{DynamicResource ComponentFocusRingBrush}" />
                <Setter TargetName="ButtonBorder" Property="BorderThickness" Value="2" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.58" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="ComboBox">
      <Setter Property="MinHeight" Value="{DynamicResource ControlHeightCompact}" />
      <Setter Property="Padding" Value="10,5" />
      <Setter Property="Background" Value="{DynamicResource ComponentInputBackgroundBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource ComponentInputForegroundBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ComponentInputBorderBrush}" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ComboBox">
            <Grid>
              <ToggleButton x:Name="DropDownToggle"
                            Focusable="False"
                            ClickMode="Press"
                            Foreground="{Binding Foreground, RelativeSource={RelativeSource TemplatedParent}}"
                            IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                <ToggleButton.Template>
                  <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="InputBorder"
                            Background="{Binding Background, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                            BorderBrush="{Binding BorderBrush, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                            BorderThickness="1"
                            CornerRadius="6">
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="32" />
                        </Grid.ColumnDefinitions>
                        <ContentPresenter Margin="10,5"
                                          VerticalAlignment="Center"
                                          Content="{Binding SelectionBoxItem, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                          ContentTemplate="{Binding SelectionBoxItemTemplate, RelativeSource={RelativeSource AncestorType=ComboBox}}" />
                        <Path Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" Data="M 0 0 L 4 4 L 8 0" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ComboBox}}" StrokeThickness="1.5" />
                      </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                      <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="InputBorder" Property="BorderBrush" Value="{DynamicResource ColourBorderStrongBrush}" />
                      </Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </ToggleButton.Template>
              </ToggleButton>
              <Popup x:Name="PART_Popup"
                     Placement="Bottom"
                     IsOpen="{TemplateBinding IsDropDownOpen}"
                     AllowsTransparency="True"
                     Focusable="False"
                     PopupAnimation="Fade">
                <Border MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                        Margin="0,2,0,0"
                        Padding="2"
                        Background="{DynamicResource ComponentInputBackgroundBrush}"
                        BorderBrush="{DynamicResource ComponentInputBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="6">
                  <ScrollViewer MaxHeight="320" CanContentScroll="True">
                    <StackPanel IsItemsHost="True" />
                  </ScrollViewer>
                </Border>
              </Popup>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsKeyboardFocusWithin" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource ComponentFocusRingBrush}" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.58" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="ComboBoxItem">
      <Setter Property="MinHeight" Value="32" />
      <Setter Property="Padding" Value="10,6" />
      <Setter Property="Foreground" Value="{DynamicResource ComponentInputForegroundBrush}" />
      <Setter Property="Background" Value="{DynamicResource ComponentInputBackgroundBrush}" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ComboBoxItem">
            <Border x:Name="ItemBorder" Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}" CornerRadius="4">
              <ContentPresenter />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsHighlighted" Value="True">
                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource ColourSelectionBackgroundBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource ColourSelectionForegroundBrush}" />
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource ColourSelectionBackgroundBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource ColourSelectionForegroundBrush}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="DataGrid">
      <Setter Property="Background" Value="{DynamicResource ComponentCardBackgroundBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource ColourTextPrimaryBrush}" />
      <Setter Property="RowBackground" Value="{DynamicResource ColourSurfaceDefaultBrush}" />
      <Setter Property="AlternatingRowBackground" Value="{DynamicResource ColourSurfaceSubtleBrush}" />
      <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource ColourBorderDefaultBrush}" />
      <Setter Property="VerticalGridLinesBrush" Value="{DynamicResource ColourBorderDefaultBrush}" />
    </Style>
    <Style TargetType="DataGridColumnHeader">
      <Setter Property="Background" Value="{DynamicResource ColourSurfaceSubtleBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource ColourTextPrimaryBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ColourBorderDefaultBrush}" />
    </Style>
    <Style TargetType="DataGridRow">
      <Setter Property="Foreground" Value="{DynamicResource ColourTextPrimaryBrush}" />
    </Style>
    <Style TargetType="DataGridCell">
      <Setter Property="BorderBrush" Value="{DynamicResource ColourBorderDefaultBrush}" />
      <Setter Property="BorderThickness" Value="0" />
      <Style.Triggers>
        <Trigger Property="IsSelected" Value="True">
          <Setter Property="Background" Value="{DynamicResource ColourSelectionBackgroundBrush}" />
          <Setter Property="Foreground" Value="{DynamicResource ColourSelectionForegroundBrush}" />
        </Trigger>
        <Trigger Property="IsKeyboardFocusWithin" Value="True">
          <Setter Property="BorderBrush" Value="{DynamicResource ComponentFocusRingBrush}" />
          <Setter Property="BorderThickness" Value="1" />
        </Trigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="SummaryCard" TargetType="Border">
      <Setter Property="Background" Value="{DynamicResource ComponentCardBackgroundBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ComponentCardBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="Padding" Value="18" />
      <Setter Property="Margin" Value="0,0,12,0" />
    </Style>
    <Style x:Key="TopbarIconButton" TargetType="Button">
      <Setter Property="Width" Value="36" />
      <Setter Property="Height" Value="36" />
      <Setter Property="MinHeight" Value="34" />
      <Setter Property="Padding" Value="7" />
      <Setter Property="Margin" Value="2,0" />
      <Setter Property="Foreground" Value="{DynamicResource ComponentShellChromeMutedBrush}" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="PreferenceBorder"
                    Padding="{TemplateBinding Padding}"
                    BorderThickness="1"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    CornerRadius="6"
                    Background="{TemplateBinding Background}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="PreferenceBorder" Property="Background" Value="{DynamicResource ComponentShellChromeSurfaceBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource ComponentShellChromeForegroundBrush}" />
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="PreferenceBorder" Property="BorderBrush" Value="{DynamicResource ComponentFocusRingBrush}" />
                <Setter TargetName="PreferenceBorder" Property="BorderThickness" Value="2" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- The cohesive chrome keeps product identity and low-emphasis preferences stable in every theme. -->
    <Border Grid.Row="0" Background="{DynamicResource ComponentShellChromeBackgroundBrush}" BorderBrush="{DynamicResource ComponentShellChromeBorderBrush}" BorderThickness="0,0,0,1" Padding="28,12">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Image Width="38" Height="38" Source="Assets/DBNotifier.ico" Stretch="Uniform" AutomationProperties.Name="DB Notifier" />
          <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
            <TextBlock Text="DB Notifier" Foreground="{DynamicResource ComponentShellChromeForegroundBrush}" FontWeight="SemiBold" FontSize="13" />
            <TextBlock Text="{DynamicResource Brand.Subtitle}" Foreground="{DynamicResource ComponentShellChromeMutedBrush}" FontSize="12" Margin="0,3,0,0" />
          </StackPanel>
        </StackPanel>
        <WrapPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
          <Button x:Name="LanguagePreferenceButton" Style="{StaticResource TopbarIconButton}" Click="LanguagePreferenceButtonClick" AutomationProperties.Name="{DynamicResource Language.Label}">
            <Viewbox Width="20" Height="20">
              <Canvas Width="24" Height="24">
                <Path Data="M 2,5 H 14 M 7,2 H 8 M 5,8 L 11,14 M 4,14 L 10,8 L 12,5 M 12,22 L 17,12 L 22,22 M 14,18 H 20" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
              </Canvas>
            </Viewbox>
          </Button>
          <Button x:Name="ThemePreferenceButton" Style="{StaticResource TopbarIconButton}" Click="ThemePreferenceButtonClick" AutomationProperties.Name="{DynamicResource Theme.Label}" Margin="4,0,10,0">
            <Grid Width="20" Height="20">
              <Viewbox x:Name="LightThemeIcon" Width="20" Height="20">
                <Canvas Width="24" Height="24">
                  <Ellipse Canvas.Left="8.5" Canvas.Top="8.5" Width="7" Height="7" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.8" />
                  <Path Data="M 12,2.5 V 5.5 M 12,18.5 V 21.5 M 2.5,12 H 5.5 M 18.5,12 H 21.5 M 5.3,5.3 L 7.4,7.4 M 16.6,16.6 L 18.7,18.7 M 18.7,5.3 L 16.6,7.4 M 7.4,16.6 L 5.3,18.7" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                </Canvas>
              </Viewbox>
              <Viewbox x:Name="DarkThemeIcon" Width="20" Height="20" Visibility="Collapsed">
                <Canvas Width="24" Height="24">
                  <Path Data="M 20,15.2 A 8.3,8.3 0 0 1 8.8,4 A 8.5,8.5 0 1 0 20,15.2 Z" Fill="Transparent" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                </Canvas>
              </Viewbox>
            </Grid>
          </Button>
          <Border Background="{DynamicResource ComponentShellChromeSurfaceBrush}" CornerRadius="14" Padding="12,6" VerticalAlignment="Center">
            <TextBlock Text="{DynamicResource Demo.Badge}" Foreground="{DynamicResource ComponentShellChromeMutedBrush}" FontSize="11" FontWeight="SemiBold" />
          </Border>
        </WrapPanel>
      </Grid>
    </Border>

    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="{DynamicResource App.Title}">
      <Grid Margin="32,28">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <StackPanel>
            <TextBlock Text="{DynamicResource Wpf.HealthTitle}" FontSize="24" FontWeight="SemiBold" />
            <TextBlock x:Name="UpdatedAtText" Foreground="{DynamicResource ColourTextSecondaryBrush}" Margin="0,5,0,0" />
          </StackPanel>
          <WrapPanel Grid.Row="1" Margin="0,16,0,0" VerticalAlignment="Center">
            <TextBlock Text="{DynamicResource Wpf.ViewLabel}" VerticalAlignment="Center" Margin="0,0,8,0" />
            <ComboBox x:Name="ViewSelector" Width="155" Margin="0,0,18,0" SelectedIndex="0" SelectionChanged="ViewSelectionChanged" AutomationProperties.Name="{DynamicResource Wpf.ViewLabel}">
              <ComboBoxItem Content="{DynamicResource Navigation.Inventory}" Tag="Inventory" />
              <ComboBoxItem Content="{DynamicResource Wpf.HistoryAlerts}" Tag="HistoryAlerts" />
              <ComboBoxItem Content="{DynamicResource Navigation.Configuration}" Tag="Configuration" />
            </ComboBox>
            <TextBlock Text="{DynamicResource Scenario.Label}" VerticalAlignment="Center" Margin="0,0,10,0" />
            <ComboBox x:Name="ScenarioSelector"
                      Width="180"
                      SelectedIndex="0"
                      SelectionChanged="ScenarioSelectionChanged"
                      AutomationProperties.Name="{DynamicResource Scenario.Label}">
              <ComboBoxItem Content="{DynamicResource Scenario.Ready}" Tag="Ready" />
              <ComboBoxItem Content="{DynamicResource Scenario.Loading}" Tag="Loading" />
              <ComboBoxItem Content="{DynamicResource Scenario.Empty}" Tag="Empty" />
              <ComboBoxItem Content="{DynamicResource Scenario.Offline}" Tag="Offline" />
              <ComboBoxItem Content="{DynamicResource Scenario.Error}" Tag="Error" />
              <ComboBoxItem Content="{DynamicResource Scenario.Denied}" Tag="Denied" />
              <ComboBoxItem Content="{DynamicResource Scenario.Maintenance}" Tag="Maintenance" />
            </ComboBox>
          </WrapPanel>
        </Grid>

        <Grid x:Name="ReadySurface" Grid.Row="1" Margin="0,22,0,0">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <UniformGrid Columns="5">
            <Border Style="{StaticResource SummaryCard}">
              <StackPanel>
                <TextBlock Text="{DynamicResource Inventory.Total}" Foreground="{DynamicResource ColourTextSecondaryBrush}" FontSize="11" FontWeight="SemiBold" />
                <TextBlock x:Name="TotalCountText" FontSize="26" FontWeight="SemiBold" Margin="0,5,0,0" />
              </StackPanel>
            </Border>
            <Border Style="{StaticResource SummaryCard}">
              <StackPanel>
                <TextBlock Text="{DynamicResource Inventory.Healthy}" Foreground="{DynamicResource ComponentStatusHealthyForegroundBrush}" FontSize="11" FontWeight="SemiBold" />
                <TextBlock x:Name="HealthyCountText" FontSize="26" FontWeight="SemiBold" Margin="0,5,0,0" />
              </StackPanel>
            </Border>
            <Border Style="{StaticResource SummaryCard}">
              <StackPanel>
                <TextBlock Text="{DynamicResource Inventory.Degraded}" Foreground="{DynamicResource ComponentStatusDegradedForegroundBrush}" FontSize="11" FontWeight="SemiBold" />
                <TextBlock x:Name="DegradedCountText" FontSize="26" FontWeight="SemiBold" Margin="0,5,0,0" />
              </StackPanel>
            </Border>
            <Border Style="{StaticResource SummaryCard}">
              <StackPanel>
                <TextBlock Text="{DynamicResource Inventory.Attention}" Foreground="{DynamicResource ComponentStatusCriticalForegroundBrush}" FontSize="11" FontWeight="SemiBold" />
                <TextBlock x:Name="AttentionCountText" FontSize="26" FontWeight="SemiBold" Margin="0,5,0,0" />
              </StackPanel>
            </Border>
            <Border Style="{StaticResource SummaryCard}" Margin="0">
              <StackPanel>
                <TextBlock Text="{DynamicResource Inventory.Stale}" Foreground="{DynamicResource ComponentStatusNeutralForegroundBrush}" FontSize="11" FontWeight="SemiBold" />
                <TextBlock x:Name="StaleCountText" FontSize="26" FontWeight="SemiBold" Margin="0,5,0,0" />
              </StackPanel>
            </Border>
          </UniformGrid>

          <Border Grid.Row="1" Background="{DynamicResource ComponentCardBackgroundBrush}" BorderBrush="{DynamicResource ComponentCardBorderBrush}" BorderThickness="1" CornerRadius="12" Margin="0,20,0,0">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
              </Grid.RowDefinitions>
              <Grid Grid.Row="0" Margin="18,14">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{DynamicResource Inventory.Title}" FontSize="16" FontWeight="SemiBold" />
                <TextBlock Grid.Column="1" Text="{DynamicResource Common.ReadOnly}" Foreground="{DynamicResource ColourTextSecondaryBrush}" />
              </Grid>
              <DataGrid x:Name="InventoryGrid"
                        Grid.Row="1"
                        AutoGenerateColumns="False"
                        IsReadOnly="True"
                        CanUserAddRows="False"
                        CanUserDeleteRows="False"
                        CanUserReorderColumns="False"
                        HeadersVisibility="Column"
                        GridLinesVisibility="Horizontal"
                        BorderThickness="0"
                        RowHeight="48"
                        ColumnHeaderHeight="42"
                        AlternatingRowBackground="{DynamicResource ColourSurfaceSubtleBrush}"
                        SelectionMode="Single"
                        AutomationProperties.Name="{DynamicResource View.Inventory.Title}">
                <DataGrid.Columns>
                  <DataGridTextColumn Header="{DynamicResource Common.Instance}" Binding="{Binding DisplayName}" Width="170" />
                  <DataGridTextColumn Header="{DynamicResource Common.Provider}" Binding="{Binding ProviderType}" Width="130" />
                  <DataGridTextColumn Header="{DynamicResource Common.Support}" Binding="{Binding SupportLabel}" Width="210" />
                  <DataGridTextColumn Header="{DynamicResource Common.Environment}" Binding="{Binding Environment}" Width="140" />
                  <DataGridTextColumn Header="{DynamicResource Common.Status}" Binding="{Binding StatusLabel}" Width="140" />
                  <DataGridTextColumn Header="{DynamicResource Common.ObservedAt}" Binding="{Binding ObservedAtLabel}" Width="180" />
                  <DataGridTextColumn Header="{DynamicResource Common.Latency}" Binding="{Binding LatencyLabel}" Width="90" />
                </DataGrid.Columns>
              </DataGrid>
            </Grid>
          </Border>
        </Grid>

        <Grid x:Name="HistoryAlertSurface" Grid.Row="1" Margin="0,22,0,0" Visibility="Collapsed">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <Border Background="{DynamicResource ComponentCardBackgroundBrush}" BorderBrush="{DynamicResource ComponentCardBorderBrush}" BorderThickness="1" CornerRadius="10">
            <Grid>
              <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
              <Grid Margin="18,14"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="{DynamicResource History.Title}" FontSize="16" FontWeight="SemiBold" /><TextBlock Grid.Column="1" Text="{DynamicResource Common.ReadOnly}" Foreground="{DynamicResource ColourTextSecondaryBrush}" /></Grid>
              <DataGrid x:Name="HistoryGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal" BorderThickness="0" RowHeight="46" ColumnHeaderHeight="40" AlternatingRowBackground="{DynamicResource ColourSurfaceSubtleBrush}" AutomationProperties.Name="{DynamicResource History.Title}">
                <DataGrid.Columns>
                  <DataGridTextColumn Header="{DynamicResource Common.TimeUtc}" Binding="{Binding OccurredAtLabel}" Width="1.1*" />
                  <DataGridTextColumn Header="{DynamicResource Common.Severity}" Binding="{Binding SeverityLabel}" Width="*" />
                  <DataGridTextColumn Header="{DynamicResource Common.Event}" Binding="{Binding EventType}" Width="*" />
                  <DataGridTextColumn Header="{DynamicResource Common.Instance}" Binding="{Binding InstanceName}" Width="1.25*" />
                  <DataGridTextColumn Header="{DynamicResource Common.Provider}" Binding="{Binding ProviderType}" Width="*" />
                  <DataGridTextColumn Header="{DynamicResource Common.Summary}" Binding="{Binding Summary}" Width="2*" />
                </DataGrid.Columns>
              </DataGrid>
            </Grid>
          </Border>
          <Border Grid.Row="1" Background="{DynamicResource ComponentCardBackgroundBrush}" BorderBrush="{DynamicResource ComponentCardBorderBrush}" BorderThickness="1" CornerRadius="10" Margin="0,18,0,0">
            <Grid>
              <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
              <Grid Margin="18,14"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="{DynamicResource Alerts.Title}" FontSize="16" FontWeight="SemiBold" /><TextBlock Grid.Column="1" x:Name="AlertSummaryText" Foreground="{DynamicResource ColourTextSecondaryBrush}" /></Grid>
              <DataGrid x:Name="AlertsGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal" BorderThickness="0" RowHeight="46" ColumnHeaderHeight="40" AlternatingRowBackground="{DynamicResource ColourSurfaceSubtleBrush}" AutomationProperties.Name="{DynamicResource Alerts.Title}">
                <DataGrid.Columns>
                  <DataGridTextColumn Header="{DynamicResource Common.Severity}" Binding="{Binding SeverityLabel}" Width="*" />
                  <DataGridTextColumn Header="{DynamicResource Common.State}" Binding="{Binding StateLabel}" Width="*" />
                  <DataGridTextColumn Header="{DynamicResource Common.Rule}" Binding="{Binding RuleName}" Width="1.2*" />
                  <DataGridTextColumn Header="{DynamicResource Common.Instance}" Binding="{Binding InstanceName}" Width="1.2*" />
                  <DataGridTextColumn Header="{DynamicResource Common.Provider}" Binding="{Binding ProviderType}" Width="*" />
                  <DataGridTextColumn Header="{DynamicResource Common.Summary}" Binding="{Binding Summary}" Width="2*" />
                </DataGrid.Columns>
              </DataGrid>
            </Grid>
          </Border>
        </Grid>

        <Grid x:Name="ConfigurationSurface" Grid.Row="1" Margin="0,22,0,0" Visibility="Collapsed">
          <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
          <Border Background="{DynamicResource ComponentCardBackgroundBrush}" BorderBrush="{DynamicResource ComponentCardBorderBrush}" BorderThickness="1" CornerRadius="10">
            <Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
              <Grid Margin="18,14"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{DynamicResource Wpf.ConfigurationTitle}" FontSize="16" FontWeight="SemiBold" /><TextBlock x:Name="ConfigurationInstanceText" Foreground="{DynamicResource ColourTextSecondaryBrush}" Margin="0,4,0,0" /></StackPanel><TextBlock Grid.Column="1" Text="{DynamicResource Common.NotPersisted}" Foreground="{DynamicResource ColourTextSecondaryBrush}" /></Grid>
              <DataGrid x:Name="ConfigurationGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column" BorderThickness="0" RowHeight="46" AutomationProperties.Name="{DynamicResource Wpf.ConfigurationTitle}"><DataGrid.Columns><DataGridTextColumn Header="{DynamicResource Common.Field}" Binding="{Binding Label}" Width="1.3*" /><DataGridTextColumn Header="{DynamicResource Common.SafeValue}" Binding="{Binding SafeValue}" Width="*" /><DataGridTextColumn Header="{DynamicResource Common.Description}" Binding="{Binding Description}" Width="2*" /></DataGrid.Columns></DataGrid>
            </Grid>
          </Border>
          <Border Grid.Row="1" Background="{DynamicResource ComponentCardBackgroundBrush}" BorderBrush="{DynamicResource ComponentCardBorderBrush}" BorderThickness="1" CornerRadius="10" Margin="0,18,0,0">
            <Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
              <Grid Margin="18,14"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{DynamicResource Configuration.AdminTitle}" FontSize="16" FontWeight="SemiBold" /><TextBlock Text="{DynamicResource Wpf.NoAction}" Foreground="{DynamicResource ColourTextSecondaryBrush}" Margin="0,4,0,0" /></StackPanel><ComboBox x:Name="PermissionSelector" Grid.Column="1" Width="170" SelectedIndex="0" AutomationProperties.Name="{DynamicResource Configuration.PermissionScenario}"><ComboBoxItem Content="{DynamicResource Configuration.Authorized}" Tag="Authorized" /><ComboBoxItem Content="{DynamicResource Configuration.Denied}" Tag="Denied" /></ComboBox></Grid>
              <DataGrid x:Name="CapabilityGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column" BorderThickness="0" RowHeight="46" SelectionMode="Single" AutomationProperties.Name="{DynamicResource Configuration.AdminTitle}"><DataGrid.Columns><DataGridTextColumn Header="{DynamicResource Common.Action}" Binding="{Binding DisplayName}" Width="*" /><DataGridTextColumn Header="{DynamicResource Common.Capability}" Binding="{Binding CapabilityId}" Width="1.2*" /><DataGridTextColumn Header="{DynamicResource Common.State}" Binding="{Binding StateLabel}" Width="*" /><DataGridTextColumn Header="{DynamicResource Common.Reason}" Binding="{Binding ReasonCode}" Width="1.5*" /></DataGrid.Columns></DataGrid>
              <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="18,12"><Button Content="{DynamicResource Wpf.ReviewSelected}" Click="ReviewCapabilityClick" Margin="0,0,10,0" /><Button Content="{DynamicResource Configuration.ViewConfirmation}" Click="PreviewConfirmationClick" /></StackPanel>
            </Grid>
          </Border>
        </Grid>

        <Border x:Name="StateSurface"
                Grid.Row="1"
                Visibility="Collapsed"
                Background="{DynamicResource ComponentCardBackgroundBrush}"
                BorderBrush="{DynamicResource ComponentCardBorderBrush}"
                BorderThickness="1"
                CornerRadius="10"
                Padding="44"
                Margin="0,22,0,0"
                MinHeight="300"
                AutomationProperties.LiveSetting="Polite">
          <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="560">
            <ProgressBar x:Name="LoadingIndicator" IsIndeterminate="True" Width="220" Height="6" Margin="0,0,0,24" />
            <TextBlock x:Name="StateSymbolText" TextAlignment="Center" FontSize="32" FontWeight="SemiBold" Foreground="{DynamicResource ColourActionPrimaryBackgroundBrush}" />
            <TextBlock x:Name="StateTitleText" TextAlignment="Center" FontSize="22" FontWeight="SemiBold" Margin="0,12,0,0" />
            <TextBlock x:Name="StateMessageText" TextAlignment="Center" TextWrapping="Wrap" Foreground="{DynamicResource ColourTextSecondaryBrush}" FontSize="14" LineHeight="22" Margin="0,10,0,0" />
            <Button x:Name="RetryButton" Content="{DynamicResource Operational.Retry}" Margin="0,22,0,0" Click="RetryButtonClick" AutomationProperties.HelpText="{DynamicResource Operational.Retry}" />
          </StackPanel>
        </Border>
      </Grid>
    </ScrollViewer>

    <Border Grid.Row="2" Background="{DynamicResource ComponentCardBackgroundBrush}" BorderBrush="{DynamicResource ComponentCardBorderBrush}" BorderThickness="0,1,0,0" Padding="28,12">
      <TextBlock Foreground="{DynamicResource ColourTextSecondaryBrush}" FontSize="12" Text="{DynamicResource Footer.Disclaimer}" TextWrapping="Wrap" />
    </Border>
  </Grid>
</Window>
