<!-- Module purpose: Defines the accessible visual structure for Main Window; behaviour remains in its code-behind module. -->
<Window x:Class="DBNotifier.Desktop.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource App.Title}"
        Width="1180"
        Height="760"
        MinWidth="820"
        MinHeight="620"
        Background="#F5F7FA"
        Foreground="#17202A"
        FontFamily="Segoe UI"
        WindowStartupLocation="CenterScreen"
        KeyboardNavigation.TabNavigation="Cycle">
  <Window.Resources>
    <SolidColorBrush x:Key="BrandBrush" Color="#0B5CAD" />
    <SolidColorBrush x:Key="InkBrush" Color="#17202A" />
    <SolidColorBrush x:Key="MutedBrush" Color="#526273" />
    <SolidColorBrush x:Key="BorderBrush" Color="#D9E0E7" />
    <Style TargetType="Button">
      <Setter Property="MinHeight" Value="38" />
      <Setter Property="Padding" Value="16,8" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="#B8C5D1" />
      <Setter Property="Background" Value="White" />
      <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style TargetType="ComboBox">
      <Setter Property="MinHeight" Value="38" />
      <Setter Property="Padding" Value="10,5" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style x:Key="SummaryCard" TargetType="Border">
      <Setter Property="Background" Value="White" />
      <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Padding" Value="16" />
      <Setter Property="Margin" Value="0,0,12,0" />
    </Style>
  </Window.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Border Grid.Row="0" Background="#0D2538" Padding="28,20">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock Text="DB-NOTIFIER" Foreground="#8CC8FF" FontWeight="SemiBold" FontSize="12" />
          <TextBlock Text="{DynamicResource View.Inventory.Title}" Foreground="White" FontWeight="SemiBold" FontSize="26" Margin="0,4,0,0" />
          <TextBlock Text="{DynamicResource Sidebar.ReadOnly}" Foreground="#C7D7E5" FontSize="13" Margin="0,5,0,0" />
        </StackPanel>
        <Border Grid.Column="1" Background="#263F52" CornerRadius="14" Padding="12,6" VerticalAlignment="Center">
          <TextBlock Text="{DynamicResource Demo.Badge}" Foreground="White" FontSize="11" FontWeight="SemiBold" />
        </Border>
      </Grid>
    </Border>

    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <Grid Margin="28,24">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <StackPanel>
            <TextBlock Text="{DynamicResource Wpf.HealthTitle}" FontSize="20" FontWeight="SemiBold" />
            <TextBlock x:Name="UpdatedAtText" Foreground="{StaticResource MutedBrush}" Margin="0,5,0,0" />
          </StackPanel>
          <WrapPanel Grid.Row="1" Margin="0,16,0,0" VerticalAlignment="Center">
            <TextBlock Text="{DynamicResource Language.Label}" VerticalAlignment="Center" Margin="0,0,8,0" />
            <ComboBox x:Name="LanguageSelector" Width="150" Margin="0,0,18,0" SelectedIndex="0" SelectionChanged="LanguageSelectionChanged" AutomationProperties.Name="{DynamicResource Language.Label}">
              <ComboBoxItem Content="{DynamicResource Language.PtBr}" Tag="pt-BR" />
              <ComboBoxItem Content="{DynamicResource Language.EnGb}" Tag="en-GB" />
            </ComboBox>
            <TextBlock Text="{DynamicResource Wpf.ViewLabel}" VerticalAlignment="Center" Margin="0,0,8,0" />
            <ComboBox x:Name="ViewSelector" Width="155" Margin="0,0,18,0" SelectedIndex="0" SelectionChanged="ViewSelectionChanged" AutomationProperties.Name="{DynamicResource Wpf.ViewLabel}">
              <ComboBoxItem Content="{DynamicResource Navigation.Inventory}" Tag="Inventory" />
              <ComboBoxItem Content="{DynamicResource Wpf.HistoryAlerts}" Tag="HistoryAlerts" />
              <ComboBoxItem Content="{DynamicResource Navigation.Configuration}" Tag="Configuration" />
            </ComboBox>
            <TextBlock Text="{DynamicResource Scenario.Label}" VerticalAlignment="Center" Margin="0,0,10,0" />
            <ComboBox x:Name="ScenarioSelector"
                      Width="180"
                      SelectedIndex="0"
                      SelectionChanged="ScenarioSelectionChanged"
                      AutomationProperties.Name="{DynamicResource Scenario.Label}">
              <ComboBoxItem Content="{DynamicResource Scenario.Ready}" Tag="Ready" />
              <ComboBoxItem Content="{DynamicResource Scenario.Loading}" Tag="Loading" />
              <ComboBoxItem Content="{DynamicResource Scenario.Empty}" Tag="Empty" />
              <ComboBoxItem Content="{DynamicResource Scenario.Offline}" Tag="Offline" />
              <ComboBoxItem Content="{DynamicResource Scenario.Error}" Tag="Error" />
              <ComboBoxItem Content="{DynamicResource Scenario.Denied}" Tag="Denied" />
              <ComboBoxItem Content="{DynamicResource Scenario.Maintenance}" Tag="Maintenance" />
            </ComboBox>
          </WrapPanel>
        </Grid>

        <Grid x:Name="ReadySurface" Grid.Row="1" Margin="0,22,0,0">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <UniformGrid Columns="5">
            <Border Style="{StaticResource SummaryCard}">
              <StackPanel>
                <TextBlock Text="{DynamicResource Inventory.Total}" Foreground="{StaticResource MutedBrush}" FontSize="11" FontWeight="SemiBold" />
                <TextBlock x:Name="TotalCountText" FontSize="26" FontWeight="SemiBold" Margin="0,5,0,0" />
              </StackPanel>
            </Border>
            <Border Style="{StaticResource SummaryCard}" BorderBrush="#81B89A">
              <StackPanel>
                <TextBlock Text="{DynamicResource Inventory.Healthy}" Foreground="#17633A" FontSize="11" FontWeight="SemiBold" />
                <TextBlock x:Name="HealthyCountText" FontSize="26" FontWeight="SemiBold" Margin="0,5,0,0" />
              </StackPanel>
            </Border>
            <Border Style="{StaticResource SummaryCard}" BorderBrush="#E3B75E">
              <StackPanel>
                <TextBlock Text="{DynamicResource Inventory.Degraded}" Foreground="#805300" FontSize="11" FontWeight="SemiBold" />
                <TextBlock x:Name="DegradedCountText" FontSize="26" FontWeight="SemiBold" Margin="0,5,0,0" />
              </StackPanel>
            </Border>
            <Border Style="{StaticResource SummaryCard}" BorderBrush="#E29A9A">
              <StackPanel>
                <TextBlock Text="{DynamicResource Inventory.Attention}" Foreground="#982B2B" FontSize="11" FontWeight="SemiBold" />
                <TextBlock x:Name="AttentionCountText" FontSize="26" FontWeight="SemiBold" Margin="0,5,0,0" />
              </StackPanel>
            </Border>
            <Border Style="{StaticResource SummaryCard}" Margin="0">
              <StackPanel>
                <TextBlock Text="{DynamicResource Inventory.Stale}" Foreground="#4E5C69" FontSize="11" FontWeight="SemiBold" />
                <TextBlock x:Name="StaleCountText" FontSize="26" FontWeight="SemiBold" Margin="0,5,0,0" />
              </StackPanel>
            </Border>
          </UniformGrid>

          <Border Grid.Row="1" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Margin="0,18,0,0">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
              </Grid.RowDefinitions>
              <Grid Grid.Row="0" Margin="18,14">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{DynamicResource Inventory.Title}" FontSize="16" FontWeight="SemiBold" />
                <TextBlock Grid.Column="1" Text="{DynamicResource Common.ReadOnly}" Foreground="{StaticResource MutedBrush}" />
              </Grid>
              <DataGrid x:Name="InventoryGrid"
                        Grid.Row="1"
                        AutoGenerateColumns="False"
                        IsReadOnly="True"
                        CanUserAddRows="False"
                        CanUserDeleteRows="False"
                        CanUserReorderColumns="False"
                        HeadersVisibility="Column"
                        GridLinesVisibility="Horizontal"
                        BorderThickness="0"
                        RowHeight="48"
                        ColumnHeaderHeight="42"
                        AlternatingRowBackground="#F8FAFC"
                        SelectionMode="Single"
                        AutomationProperties.Name="{DynamicResource View.Inventory.Title}">
                <DataGrid.Columns>
                  <DataGridTextColumn Header="{DynamicResource Common.Instance}" Binding="{Binding DisplayName}" Width="170" />
                  <DataGridTextColumn Header="{DynamicResource Common.Provider}" Binding="{Binding ProviderType}" Width="130" />
                  <DataGridTextColumn Header="{DynamicResource Common.Support}" Binding="{Binding SupportLabel}" Width="210" />
                  <DataGridTextColumn Header="{DynamicResource Common.Environment}" Binding="{Binding Environment}" Width="140" />
                  <DataGridTextColumn Header="{DynamicResource Common.Status}" Binding="{Binding StatusLabel}" Width="140" />
                  <DataGridTextColumn Header="{DynamicResource Common.ObservedAt}" Binding="{Binding ObservedAtLabel}" Width="180" />
                  <DataGridTextColumn Header="{DynamicResource Common.Latency}" Binding="{Binding LatencyLabel}" Width="90" />
                </DataGrid.Columns>
              </DataGrid>
            </Grid>
          </Border>
        </Grid>

        <Grid x:Name="HistoryAlertSurface" Grid.Row="1" Margin="0,22,0,0" Visibility="Collapsed">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <Border Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10">
            <Grid>
              <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
              <Grid Margin="18,14"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="{DynamicResource History.Title}" FontSize="16" FontWeight="SemiBold" /><TextBlock Grid.Column="1" Text="{DynamicResource Common.ReadOnly}" Foreground="{StaticResource MutedBrush}" /></Grid>
              <DataGrid x:Name="HistoryGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal" BorderThickness="0" RowHeight="46" ColumnHeaderHeight="40" AlternatingRowBackground="#F8FAFC" AutomationProperties.Name="{DynamicResource History.Title}">
                <DataGrid.Columns>
                  <DataGridTextColumn Header="{DynamicResource Common.TimeUtc}" Binding="{Binding OccurredAtLabel}" Width="1.1*" />
                  <DataGridTextColumn Header="{DynamicResource Common.Severity}" Binding="{Binding SeverityLabel}" Width="*" />
                  <DataGridTextColumn Header="{DynamicResource Common.Event}" Binding="{Binding EventType}" Width="*" />
                  <DataGridTextColumn Header="{DynamicResource Common.Instance}" Binding="{Binding InstanceName}" Width="1.25*" />
                  <DataGridTextColumn Header="{DynamicResource Common.Provider}" Binding="{Binding ProviderType}" Width="*" />
                  <DataGridTextColumn Header="{DynamicResource Common.Summary}" Binding="{Binding Summary}" Width="2*" />
                </DataGrid.Columns>
              </DataGrid>
            </Grid>
          </Border>
          <Border Grid.Row="1" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Margin="0,18,0,0">
            <Grid>
              <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
              <Grid Margin="18,14"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="{DynamicResource Alerts.Title}" FontSize="16" FontWeight="SemiBold" /><TextBlock Grid.Column="1" x:Name="AlertSummaryText" Foreground="{StaticResource MutedBrush}" /></Grid>
              <DataGrid x:Name="AlertsGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal" BorderThickness="0" RowHeight="46" ColumnHeaderHeight="40" AlternatingRowBackground="#F8FAFC" AutomationProperties.Name="{DynamicResource Alerts.Title}">
                <DataGrid.Columns>
                  <DataGridTextColumn Header="{DynamicResource Common.Severity}" Binding="{Binding SeverityLabel}" Width="*" />
                  <DataGridTextColumn Header="{DynamicResource Common.State}" Binding="{Binding StateLabel}" Width="*" />
                  <DataGridTextColumn Header="{DynamicResource Common.Rule}" Binding="{Binding RuleName}" Width="1.2*" />
                  <DataGridTextColumn Header="{DynamicResource Common.Instance}" Binding="{Binding InstanceName}" Width="1.2*" />
                  <DataGridTextColumn Header="{DynamicResource Common.Provider}" Binding="{Binding ProviderType}" Width="*" />
                  <DataGridTextColumn Header="{DynamicResource Common.Summary}" Binding="{Binding Summary}" Width="2*" />
                </DataGrid.Columns>
              </DataGrid>
            </Grid>
          </Border>
        </Grid>

        <Grid x:Name="ConfigurationSurface" Grid.Row="1" Margin="0,22,0,0" Visibility="Collapsed">
          <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
          <Border Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10">
            <Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
              <Grid Margin="18,14"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{DynamicResource Wpf.ConfigurationTitle}" FontSize="16" FontWeight="SemiBold" /><TextBlock x:Name="ConfigurationInstanceText" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0" /></StackPanel><TextBlock Grid.Column="1" Text="{DynamicResource Common.NotPersisted}" Foreground="{StaticResource MutedBrush}" /></Grid>
              <DataGrid x:Name="ConfigurationGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column" BorderThickness="0" RowHeight="46" AutomationProperties.Name="{DynamicResource Wpf.ConfigurationTitle}"><DataGrid.Columns><DataGridTextColumn Header="{DynamicResource Common.Field}" Binding="{Binding Label}" Width="1.3*" /><DataGridTextColumn Header="{DynamicResource Common.SafeValue}" Binding="{Binding SafeValue}" Width="*" /><DataGridTextColumn Header="{DynamicResource Common.Description}" Binding="{Binding Description}" Width="2*" /></DataGrid.Columns></DataGrid>
            </Grid>
          </Border>
          <Border Grid.Row="1" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Margin="0,18,0,0">
            <Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
              <Grid Margin="18,14"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{DynamicResource Configuration.AdminTitle}" FontSize="16" FontWeight="SemiBold" /><TextBlock Text="{DynamicResource Wpf.NoAction}" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0" /></StackPanel><ComboBox x:Name="PermissionSelector" Grid.Column="1" Width="170" SelectedIndex="0" AutomationProperties.Name="{DynamicResource Configuration.PermissionScenario}"><ComboBoxItem Content="{DynamicResource Configuration.Authorized}" Tag="Authorized" /><ComboBoxItem Content="{DynamicResource Configuration.Denied}" Tag="Denied" /></ComboBox></Grid>
              <DataGrid x:Name="CapabilityGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column" BorderThickness="0" RowHeight="46" SelectionMode="Single" AutomationProperties.Name="{DynamicResource Configuration.AdminTitle}"><DataGrid.Columns><DataGridTextColumn Header="{DynamicResource Common.Action}" Binding="{Binding DisplayName}" Width="*" /><DataGridTextColumn Header="{DynamicResource Common.Capability}" Binding="{Binding CapabilityId}" Width="1.2*" /><DataGridTextColumn Header="{DynamicResource Common.State}" Binding="{Binding StateLabel}" Width="*" /><DataGridTextColumn Header="{DynamicResource Common.Reason}" Binding="{Binding ReasonCode}" Width="1.5*" /></DataGrid.Columns></DataGrid>
              <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="18,12"><Button Content="{DynamicResource Wpf.ReviewSelected}" Click="ReviewCapabilityClick" Margin="0,0,10,0" /><Button Content="{DynamicResource Configuration.ViewConfirmation}" Click="PreviewConfirmationClick" /></StackPanel>
            </Grid>
          </Border>
        </Grid>

        <Border x:Name="StateSurface"
                Grid.Row="1"
                Visibility="Collapsed"
                Background="White"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="10"
                Padding="44"
                Margin="0,22,0,0"
                MinHeight="300"
                AutomationProperties.LiveSetting="Polite">
          <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="560">
            <ProgressBar x:Name="LoadingIndicator" IsIndeterminate="True" Width="220" Height="6" Margin="0,0,0,24" />
            <TextBlock x:Name="StateSymbolText" TextAlignment="Center" FontSize="32" FontWeight="SemiBold" Foreground="{StaticResource BrandBrush}" />
            <TextBlock x:Name="StateTitleText" TextAlignment="Center" FontSize="22" FontWeight="SemiBold" Margin="0,12,0,0" />
            <TextBlock x:Name="StateMessageText" TextAlignment="Center" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" FontSize="14" LineHeight="22" Margin="0,10,0,0" />
            <Button x:Name="RetryButton" Content="{DynamicResource Operational.Retry}" Margin="0,22,0,0" Click="RetryButtonClick" AutomationProperties.HelpText="{DynamicResource Operational.Retry}" />
          </StackPanel>
        </Border>
      </Grid>
    </ScrollViewer>

    <Border Grid.Row="2" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="28,12">
      <TextBlock Foreground="{StaticResource MutedBrush}" FontSize="12" Text="{DynamicResource Footer.Disclaimer}" TextWrapping="Wrap" />
    </Border>
  </Grid>
</Window>
