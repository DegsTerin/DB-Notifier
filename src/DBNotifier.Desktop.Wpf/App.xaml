<!-- Module purpose: Defines the accessible visual structure for App; behaviour remains in its code-behind module. -->
<Application x:Class="DBNotifier.Desktop.Wpf.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Generated/DesignTokens.Core.xaml" />
        <ResourceDictionary Source="Generated/DesignTokens.Light.xaml" />
        <ResourceDictionary Source="Resources/ControlStyles.xaml" />
        <ResourceDictionary Source="Generated/Localisation.pt-BR.xaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>
</Application>
