<!-- Module purpose: Renders the shared code-native semantic icon geometry used by WPF presentation components. -->
<UserControl x:Class="DBNotifier.Desktop.Wpf.SemanticIcon"
             x:ClassModifier="internal"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="20"
             Height="20"
             Focusable="False"
             IsTabStop="False"
             IsHitTestVisible="False">
  <Viewbox Stretch="Uniform">
    <Path x:Name="IconPath"
          Width="24"
          Height="24"
          Data="{Binding IconGeometry, ElementName=Root}"
          Fill="Transparent"
          Stroke="{Binding Foreground, ElementName=Root}"
          StrokeThickness="1.75"
          StrokeStartLineCap="Round"
          StrokeEndLineCap="Round"
          StrokeLineJoin="Round" />
  </Viewbox>
</UserControl>
