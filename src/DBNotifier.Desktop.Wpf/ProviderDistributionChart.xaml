<!-- Module purpose: Presents provider counts with a code-native categorical ring and authoritative provider identities. -->
<UserControl x:Class="DBNotifier.Desktop.Wpf.ProviderDistributionChart"
             x:ClassModifier="internal"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:DBNotifier.Desktop.Wpf"
             Focusable="False"
             IsTabStop="False"
             MinHeight="150">
  <Grid MinWidth="0">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="0.85*" MinWidth="96" />
      <ColumnDefinition Width="1.15*" MinWidth="130" />
    </Grid.ColumnDefinitions>
    <Viewbox Grid.Column="0" Width="126" Height="126" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center">
      <Canvas x:Name="SegmentCanvas" Width="44" Height="44" IsHitTestVisible="False">
        <Ellipse Canvas.Left="6.1" Canvas.Top="6.1" Width="31.8" Height="31.8" Fill="Transparent" Stroke="{DynamicResource ColourSurfaceSunkenBrush}" StrokeThickness="7" />
      </Canvas>
    </Viewbox>
    <ItemsControl x:Name="Legend"
                  Grid.Column="1"
                  Margin="12,0,0,0"
                  VerticalAlignment="Center"
                  AlternationCount="5"
                  Focusable="False"
                  IsTabStop="False"
                  AutomationProperties.Name="{DynamicResource Overview.ProviderFixture}">
      <ItemsControl.ItemTemplate>
        <DataTemplate>
          <Grid MinHeight="30" Margin="0,2">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="8" />
              <ColumnDefinition Width="26" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Ellipse Width="8" Height="8">
              <Ellipse.Style>
                <Style TargetType="Ellipse">
                  <Setter Property="Fill" Value="{DynamicResource ColourDataCategory1Brush}" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ContentPresenter}, Path=(ItemsControl.AlternationIndex)}" Value="1"><Setter Property="Fill" Value="{DynamicResource ColourDataCategory2Brush}" /></DataTrigger>
                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ContentPresenter}, Path=(ItemsControl.AlternationIndex)}" Value="2"><Setter Property="Fill" Value="{DynamicResource ColourDataCategory3Brush}" /></DataTrigger>
                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ContentPresenter}, Path=(ItemsControl.AlternationIndex)}" Value="3"><Setter Property="Fill" Value="{DynamicResource ColourDataCategory4Brush}" /></DataTrigger>
                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ContentPresenter}, Path=(ItemsControl.AlternationIndex)}" Value="4"><Setter Property="Fill" Value="{DynamicResource ColourDataCategory5Brush}" /></DataTrigger>
                  </Style.Triggers>
                </Style>
              </Ellipse.Style>
            </Ellipse>
            <local:ProviderIdentityView Grid.Column="1" Identity="{Binding ProviderIdentity}" IconSize="20" ShowText="False" HorizontalAlignment="Center" />
            <TextBlock Grid.Column="2" Text="{Binding ProviderIdentity.ProviderType}" FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            <TextBlock Grid.Column="3" Text="{Binding Count}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" Margin="10,0,0,0" />
          </Grid>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
  </Grid>
</UserControl>
