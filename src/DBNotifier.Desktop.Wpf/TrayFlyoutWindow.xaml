<!-- Module purpose: Defines the compact, accessible notification-area fleet overview; it presents local fixtures and safe navigation only. -->
<Window x:Class="DBNotifier.Desktop.Wpf.TrayFlyoutWindow"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Tray.FleetTitle}"
        Width="560"
        SizeToContent="Height"
        MaxHeight="620"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        AllowsTransparency="True"
        Background="Transparent"
        Foreground="{DynamicResource ColourTextPrimaryBrush}"
        FontFamily="{DynamicResource TypographyFontfamilySans}"
        KeyboardNavigation.TabNavigation="Cycle"
        AutomationProperties.Name="{DynamicResource Tray.FleetTitle}"
        Deactivated="WindowDeactivated"
        PreviewKeyDown="WindowPreviewKeyDown"
        Closing="WindowClosing">
  <Window.Resources>
    <Style x:Key="TrayActionButton" TargetType="Button">
      <Setter Property="MinHeight" Value="{DynamicResource ControlHeightCompact}" />
      <!-- Padding is a Thickness; a numeric spacing resource cannot be assigned through a runtime resource lookup. -->
      <Setter Property="Padding" Value="12" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="Foreground" Value="{DynamicResource ColourTextPrimaryBrush}" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="ActionSurface"
                    Padding="{TemplateBinding Padding}"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="6">
              <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="ActionSurface" Property="Background" Value="{DynamicResource ColourSurfaceSubtleBrush}" />
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="ActionSurface" Property="BorderBrush" Value="{DynamicResource ComponentFocusRingBrush}" />
                <Setter TargetName="ActionSurface" Property="BorderThickness" Value="2" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="TrayInstanceRow" TargetType="Grid">
      <Setter Property="Margin" Value="0,4" />
      <Setter Property="MinHeight" Value="48" />
    </Style>
  </Window.Resources>

  <Border Background="{DynamicResource ComponentCardBackgroundBrush}"
          BorderBrush="{DynamicResource ColourBorderStrongBrush}"
          BorderThickness="1"
          CornerRadius="12">
    <Grid>
      <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>

      <!-- The header identifies the product and keeps demonstration truth visible before any operational content. -->
      <Grid Margin="16,14">
        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
        <Image x:Name="BrandStatusImage" Width="32" Height="32" Stretch="None" SnapsToDevicePixels="True" AutomationProperties.Name="DB Notifier" />
        <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center"><StackPanel Orientation="Horizontal"><TextBlock Text="DB" Foreground="{DynamicResource ComponentBrandWordmarkAccentBrush}" FontSize="16" FontWeight="Bold" /><TextBlock Text="Notifier" FontSize="16" FontWeight="Bold" /></StackPanel><TextBlock Text="{DynamicResource Tray.FleetTitle}" Foreground="{DynamicResource ColourTextSecondaryBrush}" FontSize="11" Margin="0,2,0,0" /></StackPanel>
        <Border Grid.Column="2" Padding="8,4" Background="{DynamicResource ColourStatusInformationBackgroundBrush}" CornerRadius="999" VerticalAlignment="Center"><TextBlock Text="{DynamicResource Demo.Badge}" Foreground="{DynamicResource ColourStatusInformationForegroundBrush}" FontSize="10" FontWeight="SemiBold" /></Border>
      </Grid>

      <!-- The two-column body separates fleet evidence from safe application navigation. -->
      <Grid Grid.Row="1">
        <Grid.ColumnDefinitions><ColumnDefinition Width="1.12*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
        <Border BorderBrush="{DynamicResource ColourBorderDefaultBrush}" BorderThickness="0,1,1,1" Padding="16,10">
          <StackPanel AutomationProperties.Name="{DynamicResource Tray.Instances}">
            <TextBlock Text="{DynamicResource Overview.FleetStatus}" FontWeight="SemiBold" Margin="0,0,0,6" />
            <Grid Style="{StaticResource TrayInstanceRow}"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><Ellipse Width="9" Height="9" Fill="{DynamicResource ComponentStatusHealthyForegroundBrush}" Margin="0,0,10,0" /><StackPanel Grid.Column="1"><TextBlock Text="{DynamicResource Sample.Instance.Finance}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" /><TextBlock Text="postgresql" Foreground="{DynamicResource ColourTextSecondaryBrush}" FontSize="10" Margin="0,3,0,0" /></StackPanel><TextBlock Grid.Column="2" Text="{DynamicResource Status.Healthy}" Foreground="{DynamicResource ComponentStatusHealthyForegroundBrush}" FontSize="11" VerticalAlignment="Center" /></Grid>
            <Grid Style="{StaticResource TrayInstanceRow}"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><Ellipse Width="9" Height="9" Fill="{DynamicResource ComponentStatusDegradedForegroundBrush}" Margin="0,0,10,0" /><StackPanel Grid.Column="1"><TextBlock Text="{DynamicResource Sample.Instance.Orders}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" /><TextBlock Text="mysql" Foreground="{DynamicResource ColourTextSecondaryBrush}" FontSize="10" Margin="0,3,0,0" /></StackPanel><TextBlock Grid.Column="2" Text="{DynamicResource Status.Degraded}" Foreground="{DynamicResource ComponentStatusDegradedForegroundBrush}" FontSize="11" VerticalAlignment="Center" /></Grid>
            <Grid Style="{StaticResource TrayInstanceRow}"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><Rectangle Width="9" Height="9" Fill="{DynamicResource ComponentStatusCriticalForegroundBrush}" Margin="0,0,10,0" RadiusX="2" RadiusY="2" /><StackPanel Grid.Column="1"><TextBlock Text="{DynamicResource Sample.Instance.Analytics}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" /><TextBlock Text="sql-server" Foreground="{DynamicResource ColourTextSecondaryBrush}" FontSize="10" Margin="0,3,0,0" /></StackPanel><TextBlock Grid.Column="2" Text="{DynamicResource Status.Timeout}" Foreground="{DynamicResource ComponentStatusCriticalForegroundBrush}" FontSize="11" VerticalAlignment="Center" /></Grid>
            <Grid Style="{StaticResource TrayInstanceRow}"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><Ellipse Width="9" Height="9" Stroke="{DynamicResource ComponentStatusNeutralForegroundBrush}" StrokeThickness="2" Margin="0,0,10,0" /><StackPanel Grid.Column="1"><TextBlock Text="{DynamicResource Sample.Instance.Catalogue}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" /><TextBlock Text="mongodb" Foreground="{DynamicResource ColourTextSecondaryBrush}" FontSize="10" Margin="0,3,0,0" /></StackPanel><TextBlock Grid.Column="2" Text="{DynamicResource Status.Stale}" Foreground="{DynamicResource ComponentStatusNeutralForegroundBrush}" FontSize="11" VerticalAlignment="Center" /></Grid>
          </StackPanel>
        </Border>

        <!-- Every enabled action navigates inside DB Notifier; service control remains explanatory and non-interactive. -->
        <Border Grid.Column="1" BorderBrush="{DynamicResource ColourBorderDefaultBrush}" BorderThickness="0,1,0,1" Padding="10">
          <StackPanel>
            <Button Style="{StaticResource TrayActionButton}" Click="OpenOverviewClick" AutomationProperties.Name="{DynamicResource Tray.OpenOverview}"><StackPanel Orientation="Horizontal"><Path Width="17" Height="17" Data="M2,8 L8,2 L14,8 M4,7 V14 H12 V7 M7,14 V10 H9 V14" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.4" Stretch="Uniform" Margin="0,0,10,0" /><TextBlock Text="{DynamicResource Tray.OpenOverview}" FontWeight="SemiBold" /></StackPanel></Button>
            <Button Style="{StaticResource TrayActionButton}" Click="OpenConfigurationClick" AutomationProperties.Name="{DynamicResource Tray.OpenConfiguration}"><StackPanel Orientation="Horizontal"><Path Width="17" Height="17" Data="M2,4 H10 M13,4 H16 M2,12 H5 M8,12 H16 M11.5,2 V6 M6.5,10 V14" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.4" Stretch="Uniform" Margin="0,0,10,0" /><TextBlock Text="{DynamicResource Tray.OpenConfiguration}" FontWeight="SemiBold" /></StackPanel></Button>
            <Button Style="{StaticResource TrayActionButton}" Click="OpenHistoryAlertsClick" AutomationProperties.Name="{DynamicResource Tray.OpenHistoryAlerts}"><StackPanel Orientation="Horizontal"><Path Width="17" Height="17" Data="M3,2 H13 L16,5 V15 H3 Z M13,2 V5 H16 M6,8 H13 M6,11 H13" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.4" Fill="Transparent" Stretch="Uniform" Margin="0,0,10,0" /><TextBlock Text="{DynamicResource Tray.OpenHistoryAlerts}" FontWeight="SemiBold" /></StackPanel></Button>
            <Border Background="{DynamicResource ColourSurfaceSubtleBrush}" CornerRadius="6" Padding="10" Margin="2,4"><StackPanel><TextBlock Text="{DynamicResource Tray.RestartUnavailable}" Foreground="{DynamicResource ColourTextSecondaryBrush}" FontWeight="SemiBold" /><TextBlock Text="{DynamicResource Tray.RestartUnavailableHelp}" Foreground="{DynamicResource ColourTextMutedBrush}" FontSize="10" TextWrapping="Wrap" Margin="0,3,0,0" /></StackPanel></Border>
            <Border Background="{DynamicResource ColourSurfaceSubtleBrush}" CornerRadius="6" Padding="10" Margin="2,4"><StackPanel><TextBlock Text="{DynamicResource Tray.SilentUnavailable}" Foreground="{DynamicResource ColourTextSecondaryBrush}" FontWeight="SemiBold" /><TextBlock Text="{DynamicResource Tray.SilentUnavailableHelp}" Foreground="{DynamicResource ColourTextMutedBrush}" FontSize="10" TextWrapping="Wrap" Margin="0,3,0,0" /></StackPanel></Border>
            <Border Height="1" Background="{DynamicResource ColourBorderDefaultBrush}" Margin="2,6" />
            <Button Style="{StaticResource TrayActionButton}" Click="ExitClick" AutomationProperties.Name="{DynamicResource Tray.Exit}"><StackPanel Orientation="Horizontal"><Path Width="17" Height="17" Data="M7,2 H2 V14 H7 M10,5 L15,8 L10,11 M5,8 H15" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.4" Stretch="Uniform" Margin="0,0,10,0" /><TextBlock Text="{DynamicResource Tray.Exit}" FontWeight="SemiBold" /></StackPanel></Button>
          </StackPanel>
        </Border>
      </Grid>

      <!-- Aggregate state is textual and freshness remains explicit; the static icon does not claim live integration. -->
      <Grid Grid.Row="2" Margin="16,10"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{DynamicResource Tray.FleetSummary}" FontSize="11" FontWeight="SemiBold" /><TextBlock x:Name="AggregateText" Foreground="{DynamicResource ColourTextSecondaryBrush}" FontSize="10" Margin="0,3,0,0" /><TextBlock x:Name="SnapshotText" Foreground="{DynamicResource ColourTextMutedBrush}" FontSize="10" Margin="0,3,0,0" /></StackPanel><TextBlock Grid.Column="1" Text="STATE-05" Foreground="{DynamicResource ColourActionPrimaryBackgroundBrush}" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center" /></Grid>
    </Grid>
  </Border>
</Window>
