<!-- Module purpose: Presents one decorative provider logo and authoritative provider identifier with a neutral accessible fallback. -->
<UserControl x:Class="DBNotifier.Desktop.Wpf.ProviderIdentityView"
             x:ClassModifier="internal"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:DBNotifier.Desktop.Wpf"
             Focusable="False"
             IsTabStop="False"
             HorizontalContentAlignment="Stretch"
             Foreground="{DynamicResource ColourTextSecondaryBrush}"
             FontSize="11">
  <Grid MinWidth="0" VerticalAlignment="Center">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="Auto" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>
    <!-- The artwork is decorative; adjacent stable text remains the provider identity and status is rendered separately. -->
    <Grid Grid.Column="0"
          Width="{Binding IconSize, ElementName=Root}"
          Height="{Binding IconSize, ElementName=Root}"
          IsHitTestVisible="False">
      <Viewbox x:Name="FallbackGlyph" Stretch="Uniform">
        <Canvas Width="32" Height="32">
          <Path Data="M6,8 C6,5.8 10.5,4 16,4 C21.5,4 26,5.8 26,8 C26,10.2 21.5,12 16,12 C10.5,12 6,10.2 6,8 M6,8 V24 C6,26.2 10.5,28 16,28 C21.5,28 26,26.2 26,24 V8 M6,16 C6,18.2 10.5,20 16,20 C21.5,20 26,18.2 26,16"
                Stroke="{DynamicResource ColourTextSecondaryBrush}"
                StrokeThickness="1.8"
                StrokeStartLineCap="Round"
                StrokeEndLineCap="Round"
                StrokeLineJoin="Round"
                Fill="Transparent" />
        </Canvas>
      </Viewbox>
      <local:DecorativeProviderImage x:Name="ProviderImage"
                                     Visibility="Collapsed"
                                     Stretch="Uniform"
                                     SnapsToDevicePixels="True"
                                     RenderOptions.BitmapScalingMode="HighQuality"
                                     ImageFailed="ProviderImageFailed" />
    </Grid>
    <TextBlock x:Name="ProviderText"
               Grid.Column="1"
               MinWidth="0"
               Margin="7,0,0,0"
               VerticalAlignment="Center"
               Visibility="{Binding TextVisibility, ElementName=Root}"
               Foreground="{Binding Foreground, ElementName=Root}"
               FontSize="{Binding FontSize, ElementName=Root}"
               FontWeight="{Binding FontWeight, ElementName=Root}"
               TextTrimming="CharacterEllipsis" />
  </Grid>
</UserControl>
