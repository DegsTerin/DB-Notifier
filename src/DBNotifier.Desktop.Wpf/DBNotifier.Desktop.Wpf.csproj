<!-- Module purpose: Defines .NET 10 build settings and dependencies for DBNotifier Desktop Wpf. -->
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSdkBootstrapInitialize>false</WindowsAppSdkBootstrapInitialize>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ApplicationIcon>Assets\DBNotifier.ico</ApplicationIcon>
    <AssemblyTitle>DB Notifier</AssemblyTitle>
    <Product>DB Notifier</Product>
    <Description>DB Notifier Windows notification-area client</Description>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="Assets\DBNotifier*.ico" />
    <Content Include="NotificationAssets\DBNotifier.Availability.png" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="NotificationAssets\DBNotifier.Healthy.png" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="NotificationAssets\DBNotifier.Warning.png" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="NotificationAssets\DBNotifier.Critical.png" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="NotificationAssets\DBNotifier.Unknown.png" CopyToOutputDirectory="PreserveNewest" />
    <PackageReference Include="Microsoft.WindowsAppSDK" />
    <ProjectReference Include="..\DBNotifier.Application\DBNotifier.Application.csproj" />
    <ProjectReference Include="..\DBNotifier.Infrastructure\DBNotifier.Infrastructure.csproj" />
  </ItemGroup>
</Project>
