<!-- Module purpose: Defines .NET 10 build settings and dependencies for DBNotifier Desktop Wpf. -->
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ApplicationIcon>Assets\DBNotifier.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="Assets\DBNotifier*.ico" />
    <ProjectReference Include="..\DBNotifier.Application\DBNotifier.Application.csproj" />
    <ProjectReference Include="..\DBNotifier.Infrastructure\DBNotifier.Infrastructure.csproj" />
  </ItemGroup>
</Project>
