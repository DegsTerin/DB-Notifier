{
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "ServerDatabase": null
  },
  "HumanAuthentication": {
    "Authority": null,
    "Audience": null
  },
  "DBNotifier": {
    "Operations": {
      "RetentionEnabled": false,
      "RetentionApplyChanges": false,
      "ServerOutboxEnabled": false,
      "NotificationDeliveryEnabled": false,
      "IntervalSeconds": 30,
      "MaximumBatchSize": 50
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}
