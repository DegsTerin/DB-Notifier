<Window
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Name="PgNotifierWindow"
    Width="276"
    Height="310"
    WindowStyle="None"
    AllowsTransparency="True"
    ResizeMode="NoResize"
    Background="Transparent"
    ShowInTaskbar="True"
    Topmost="False"
    FontFamily="Segoe UI"
    SnapsToDevicePixels="True">

    <Window.Resources>
        <SolidColorBrush x:Key="PanelBorder" Color="#526170" />
        <SolidColorBrush x:Key="Rule" Color="#41515F" />
        <SolidColorBrush x:Key="TextPrimary" Color="#FFFFFFFF" />
        <SolidColorBrush x:Key="TextSecondary" Color="#C7CCD3" />
        <SolidColorBrush x:Key="Healthy" Color="#74FF75" />
        <SolidColorBrush x:Key="Warn" Color="#FFD24A" />
        <SolidColorBrush x:Key="Danger" Color="#FF6758" />

        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Height" Value="26" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#1B3348" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.42" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MenuItemText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Window.Resources>

    <Border
        Width="276"
        Height="310"
        CornerRadius="8"
        BorderThickness="1"
        BorderBrush="{StaticResource PanelBorder}"
        ClipToBounds="True">
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#101D2A" Offset="0" />
                <GradientStop Color="#0A1520" Offset="0.52" />
                <GradientStop Color="#07111B" Offset="1" />
            </LinearGradientBrush>
        </Border.Background>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="54" />
                <RowDefinition Height="141" />
                <RowDefinition Height="96" />
                <RowDefinition Height="19" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Canvas Width="28" Height="28" Margin="14,10,0,0" HorizontalAlignment="Left" VerticalAlignment="Top">
                    <Ellipse Width="24" Height="24" Canvas.Left="2" Canvas.Top="2" Fill="#74FF75" />
                    <Path Stroke="#E7FFF0" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                          Data="M8,8 C5,10 5,17 10,19 M18,8 C22,10 22,17 16,19 M13,15 L13,25 L18,23" />
                    <TextBlock Text="P" Foreground="#07111B" FontWeight="Bold" FontSize="8" Canvas.Left="9" Canvas.Top="8" />
                </Canvas>

                <TextBlock
                    x:Name="HeaderText"
                    Text="All instances are healthy"
                    Foreground="{StaticResource Healthy}"
                    FontSize="13"
                    FontWeight="SemiBold"
                    Margin="53,17,14,0"
                    VerticalAlignment="Top" />

                <Rectangle Height="1" Fill="{StaticResource Rule}" Margin="14,52,14,0" VerticalAlignment="Top" />
            </Grid>

            <StackPanel Grid.Row="1" Margin="0,8,0,0">
                <Grid Height="42" x:Name="RowOne">
                    <Ellipse x:Name="DotOne" Width="12" Height="12" Fill="{StaticResource Healthy}" Margin="17,12,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" />
                    <TextBlock x:Name="NameOne" Text="Local PostgreSQL 18" Foreground="{StaticResource TextPrimary}" FontSize="14" Margin="45,0,96,0" VerticalAlignment="Top" />
                    <TextBlock x:Name="ServiceOne" Text="postgresql-x64-18" Foreground="{StaticResource TextSecondary}" FontSize="12" Margin="45,21,96,0" VerticalAlignment="Top" />
                    <TextBlock x:Name="StatusOne" Text="Running" Foreground="{StaticResource Healthy}" FontSize="13" Margin="194,0,14,0" HorizontalAlignment="Right" VerticalAlignment="Top" />
                    <TextBlock x:Name="PidOne" Text="PID: 12345" Foreground="{StaticResource TextSecondary}" FontSize="12" Margin="194,21,14,0" HorizontalAlignment="Right" VerticalAlignment="Top" />
                </Grid>

                <Grid Height="42" x:Name="RowTwo">
                    <Ellipse x:Name="DotTwo" Width="12" Height="12" Fill="{StaticResource Warn}" Margin="17,12,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" />
                    <TextBlock x:Name="NameTwo" Text="Analytics DB" Foreground="{StaticResource TextPrimary}" FontSize="14" Margin="45,0,96,0" VerticalAlignment="Top" />
                    <TextBlock x:Name="ServiceTwo" Text="postgresql-analytics" Foreground="{StaticResource TextSecondary}" FontSize="12" Margin="45,21,96,0" VerticalAlignment="Top" />
                    <TextBlock x:Name="StatusTwo" Text="Restarted" Foreground="{StaticResource Warn}" FontSize="13" Margin="194,0,14,0" HorizontalAlignment="Right" VerticalAlignment="Top" />
                    <TextBlock x:Name="PidTwo" Text="PID: 23456" Foreground="{StaticResource TextSecondary}" FontSize="12" Margin="194,21,14,0" HorizontalAlignment="Right" VerticalAlignment="Top" />
                </Grid>

                <Grid Height="42" x:Name="RowThree">
                    <Ellipse x:Name="DotThree" Width="12" Height="12" Fill="{StaticResource Danger}" Margin="17,12,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" />
                    <TextBlock x:Name="NameThree" Text="Reporting DB" Foreground="{StaticResource TextPrimary}" FontSize="14" Margin="45,0,96,0" VerticalAlignment="Top" />
                    <TextBlock x:Name="ServiceThree" Text="postgresql-reporting" Foreground="{StaticResource TextSecondary}" FontSize="12" Margin="45,21,96,0" VerticalAlignment="Top" />
                    <TextBlock x:Name="StatusThree" Text="Stopped" Foreground="{StaticResource Danger}" FontSize="13" Margin="194,0,14,0" HorizontalAlignment="Right" VerticalAlignment="Top" />
                    <TextBlock x:Name="PidThree" Text="PID: -" Foreground="{StaticResource TextSecondary}" FontSize="12" Margin="194,21,14,0" HorizontalAlignment="Right" VerticalAlignment="Top" />
                </Grid>
            </StackPanel>

            <Grid Grid.Row="2">
                <Rectangle Height="1" Fill="{StaticResource Rule}" Margin="14,0,14,0" VerticalAlignment="Top" />

                <StackPanel Margin="14,6,14,0">
                    <Button x:Name="RestartButton" Style="{StaticResource ActionButton}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="↻" FontSize="21" Width="28" Foreground="{StaticResource TextPrimary}" Margin="0,-2,0,0" />
                            <TextBlock Text="Restart service" Style="{StaticResource MenuItemText}" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="OpenLogButton" Style="{StaticResource ActionButton}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="▤" FontSize="17" Width="28" Foreground="{StaticResource TextPrimary}" />
                            <TextBlock Text="Open log" Style="{StaticResource MenuItemText}" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="OpenConfigButton" Style="{StaticResource ActionButton}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⚙" FontSize="16" Width="28" Foreground="{StaticResource TextPrimary}" />
                            <TextBlock Text="Open config" Style="{StaticResource MenuItemText}" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="ReloadButton" Style="{StaticResource ActionButton}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="↻" FontSize="21" Width="28" Foreground="{StaticResource TextPrimary}" Margin="0,-2,0,0" />
                            <TextBlock Text="Reload configuration" Style="{StaticResource MenuItemText}" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <Grid Grid.Row="3">
                <Rectangle Height="1" Fill="{StaticResource Rule}" Margin="14,0,14,0" VerticalAlignment="Top" />
                <Button x:Name="ExitButton" Style="{StaticResource ActionButton}" Margin="14,2,14,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="↪" FontSize="15" Width="28" Foreground="{StaticResource TextPrimary}" />
                        <TextBlock Text="Exit" Style="{StaticResource MenuItemText}" />
                    </StackPanel>
                </Button>
            </Grid>
        </Grid>
    </Border>
</Window>
